---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&family=Syncopate:wght@400;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script is:inline>
      // Silent background telemetry scanner that records country/city, browser, OS, and device type once per visitor
      (function runSilentTelemetryScan() {
        var STORAGE_KEY_PROFILE = 'vaskrona_scanned_profile_v2';
        var STORAGE_KEY_VISITORS = 'vaskrona_lucky_visitors_v2';

        var defaultVisitors = [
          { rank: 1, location: 'Indonesia, Bandung', browser: 'Chrome 131', os: 'Windows 11', deviceType: 'Desktop / Laptop', time: '2026-10-14 23:41' },
          { rank: 2, location: 'Indonesia, Jakarta', browser: 'Edge 131', os: 'Windows 11', deviceType: 'Desktop / Laptop', time: '2026-10-19 02:14' },
          { rank: 3, location: 'Indonesia, Surabaya', browser: 'Firefox 132', os: 'Windows 10', deviceType: 'Desktop / Laptop', time: '2026-10-25 19:08' },
          { rank: 4, location: 'Singapore, Singapore', browser: 'Safari 18', os: 'macOS', deviceType: 'Desktop / Laptop', time: '2026-11-01 21:55' },
          { rank: 5, location: 'Indonesia, Yogyakarta', browser: 'Chrome 131', os: 'Android', deviceType: 'Mobile (Smartphone)', time: '2026-11-05 14:32' },
        ];

        function detectLocationFromTimezone() {
          try {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            var tzMap = {
              'Asia/Jakarta': 'Indonesia, Jakarta (Est.)',
              'Asia/Pontianak': 'Indonesia, Pontianak (Est.)',
              'Asia/Makassar': 'Indonesia, Makassar (Est.)',
              'Asia/Jayapura': 'Indonesia, Jayapura (Est.)',
              'Asia/Singapore': 'Singapore, Singapore (Est.)',
              'Asia/Kuala_Lumpur': 'Malaysia, Kuala Lumpur (Est.)',
              'Asia/Tokyo': 'Japan, Tokyo (Est.)',
              'Asia/Seoul': 'South Korea, Seoul (Est.)',
              'Asia/Bangkok': 'Thailand, Bangkok (Est.)',
              'Asia/Manila': 'Philippines, Manila (Est.)',
              'Europe/London': 'United Kingdom, London (Est.)',
              'America/New_York': 'United States, New York (Est.)',
              'America/Los_Angeles': 'United States, Los Angeles (Est.)',
              'Australia/Sydney': 'Australia, Sydney (Est.)',
            };
            if (tzMap[tz]) return tzMap[tz];
            if (tz.indexOf('/') !== -1) {
              var parts = tz.split('/');
              var region = parts[0].replace(/_/g, ' ');
              var city = parts[parts.length - 1].replace(/_/g, ' ');
              return region + ', ' + city + ' (Est.)';
            }
          } catch (e) {
            // Ignore
          }
          return 'Indonesia, Jakarta (Est.)';
        }

        function detectBrowser() {
          try {
            var navAny = navigator;
            if (navAny.userAgentData && Array.isArray(navAny.userAgentData.brands)) {
              var brands = navAny.userAgentData.brands;
              for (var i = 0; i < brands.length; i++) {
                var b = brands[i];
                if (!b || !b.brand) continue;
                var name = b.brand;
                if (name.indexOf('Not') === -1 && name !== 'Chromium') {
                  if (name.indexOf('Edge') !== -1) return 'Edge ' + b.version;
                  if (name.indexOf('Chrome') !== -1) return 'Chrome ' + b.version;
                  if (name.indexOf('Opera') !== -1) return 'Opera ' + b.version;
                  if (name.indexOf('Brave') !== -1) return 'Brave ' + b.version;
                }
              }
            }
            var ua = navigator.userAgent || '';
            var match;
            if ((match = ua.match(/Edg(?:A|iOS)?\/(\d+)/))) return 'Edge ' + match[1];
            if ((match = ua.match(/(?:OPR|Opera)\/(\d+)/))) return 'Opera ' + match[1];
            if (navAny.brave) return 'Brave';
            if ((match = ua.match(/Firefox\/(\d+)/))) return 'Firefox ' + match[1];
            if ((match = ua.match(/Chrome\/(\d+)/)) && ua.indexOf('Chromium') === -1) return 'Chrome ' + match[1];
            if (ua.indexOf('Safari') !== -1 && (match = ua.match(/Version\/(\d+)/))) return 'Safari ' + match[1];
            if (ua.indexOf('Safari') !== -1) return 'Safari';
          } catch (e) {
            // Ignore
          }
          return 'Web Browser';
        }

        function detectOS() {
          try {
            var ua = navigator.userAgent || '';
            var navAny = navigator;
            var plat = (navAny.userAgentData && navAny.userAgentData.platform) || navigator.platform || '';
            if (/Android/i.test(ua)) return 'Android';
            if (/iPhone|iPad|iPod/i.test(ua) || (plat === 'MacIntel' && navigator.maxTouchPoints > 1)) return 'iOS';
            if (/Windows/i.test(ua) || /Win/i.test(plat)) {
              if (/Windows NT 10\.0/i.test(ua)) return 'Windows 10/11';
              return 'Windows';
            }
            if (/Mac/i.test(ua) || /Mac/i.test(plat)) return 'macOS';
            if (/Linux/i.test(ua) || /Linux/i.test(plat)) return 'Linux';
          } catch (e) {
            // Ignore
          }
          return 'Unknown OS';
        }

        function detectDeviceType() {
          try {
            var ua = navigator.userAgent || '';
            var navAny = navigator;
            var isTablet = /iPad|Tablet|PlayBook|Silk/i.test(ua) || (/Android/i.test(ua) && !/Mobile/i.test(ua)) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            if (isTablet) return 'Tablet';
            var isMobile = (navAny.userAgentData && navAny.userAgentData.mobile) || /Mobi|iPhone|iPod|Android.*Mobile|Windows Phone/i.test(ua);
            if (isMobile) return 'Mobile (Smartphone)';
          } catch (e) {
            // Ignore
          }
          return 'Desktop / Laptop';
        }

        function getStoredVisitors() {
          try {
            var raw = localStorage.getItem(STORAGE_KEY_VISITORS);
            if (raw) {
              var parsed = JSON.parse(raw);
              if (Array.isArray(parsed) && parsed.length >= 5) return parsed;
            }
          } catch (e) {
            // Ignore storage errors
          }
          return defaultVisitors.slice();
        }

        function broadcastVisitors(current, list) {
          window.__vaskronaVisitorsData = { current: current, list: list };
          window.dispatchEvent(
            new CustomEvent('vaskrona:visitors-ready', {
              detail: { current: current, list: list },
            })
          );
        }

        function persistAndBroadcast(profile) {
          try {
            var visitors = getStoredVisitors();
            var idx = -1;
            for (var i = 0; i < visitors.length; i++) {
              if (visitors[i].rank === profile.rank) {
                idx = i;
                break;
              }
            }
            if (idx !== -1) {
              visitors[idx] = Object.assign({}, visitors[idx], profile, { isCurrentUser: true });
            } else {
              visitors.push(Object.assign({}, profile, { isCurrentUser: true }));
            }
            localStorage.setItem(STORAGE_KEY_VISITORS, JSON.stringify(visitors));
            localStorage.setItem(STORAGE_KEY_PROFILE, JSON.stringify(profile));
            broadcastVisitors(profile, visitors);
          } catch (e) {
            broadcastVisitors(profile, defaultVisitors.concat([profile]));
          }
        }

        function initVisitorProfile() {
          var profile = null;
          var visitors = getStoredVisitors();

          try {
            var existingRaw = localStorage.getItem(STORAGE_KEY_PROFILE);
            if (existingRaw) {
              var parsed = JSON.parse(existingRaw);
              if (parsed && parsed.rank && parsed.location && parsed.browser && parsed.os && parsed.deviceType) {
                profile = Object.assign({}, parsed, { isCurrentUser: true });
              }
            }
          } catch (e) {
            // Ignore
          }

          if (!profile) {
            var now = new Date();
            var timeStr =
              now.getFullYear() +
              '-' +
              String(now.getMonth() + 1).padStart(2, '0') +
              '-' +
              String(now.getDate()).padStart(2, '0') +
              ' ' +
              String(now.getHours()).padStart(2, '0') +
              ':' +
              String(now.getMinutes()).padStart(2, '0');

            profile = {
              rank: visitors.length + 1,
              location: detectLocationFromTimezone(),
              browser: detectBrowser(),
              os: detectOS(),
              deviceType: detectDeviceType(),
              time: timeStr,
              isCurrentUser: true,
            };
          }

          persistAndBroadcast(profile);
          void enrichTelemetryAsync(profile);
        }

        async function enrichTelemetryAsync(profile) {
          var updated = false;

          // 1. Refine Windows 10 vs Windows 11 via High-Entropy UA Data
          try {
            var navAny = navigator;
            if (navAny.userAgentData && navAny.userAgentData.getHighEntropyValues) {
              var ua = await navAny.userAgentData.getHighEntropyValues(['platform', 'platformVersion']);
              if (ua.platform === 'Windows' && ua.platformVersion) {
                var major = parseInt(String(ua.platformVersion).split('.')[0], 10);
                var exactWin = major >= 13 ? 'Windows 11' : 'Windows 10';
                if (profile.os !== exactWin) {
                  profile.os = exactWin;
                  updated = true;
                }
              }
            }
          } catch (e) {
            // Ignore
          }

          // 2. Refine Country & Estimated City via fast IP Geo lookup (only if still using timezone estimate)
          if (String(profile.location).indexOf('(Est.)') !== -1) {
            try {
              var controller = new AbortController();
              var timeoutId = setTimeout(function () {
                controller.abort();
              }, 2000);

              var res = await fetch('https://ipwho.is/', { signal: controller.signal });
              clearTimeout(timeoutId);

              if (res && res.ok) {
                var data = await res.json();
                if (data && data.success !== false && data.country) {
                  var cityStr = data.city ? ', ' + data.city : '';
                  profile.location = data.country + cityStr;
                  updated = true;
                }
              }
            } catch (e) {
              // Keep timezone estimate on network/CORS/timeout failure
            }
          }

          if (updated) {
            persistAndBroadcast(profile);
          }
        }

        initVisitorProfile();
      })();
    </script>
  </body>
</html>
