---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="CLASSIFIED // VASKRONA UNDERGROUND">
  <main class="relative min-h-screen bg-[#050505] text-[#e5e5e5] overflow-hidden flex flex-col justify-between select-none">
    <!-- Atmospheric Scanlines & Underground Grid -->
    <div class="pointer-events-none fixed inset-0 dot-matrix-bg opacity-40"></div>
    <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(163,163,163,0.14),transparent_65%)]"></div>

    <!-- Ceiling Breach Light Beam (from the hole in the footer above) -->
    <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[420px] h-[520px] bg-gradient-to-b from-[#e5e5e5]/15 via-[#a3a3a3]/5 to-transparent blur-2xl"></div>

    <!-- Top Classified Bar -->
    <header class="relative z-10 w-[94%] max-w-[1480px] mx-auto border-x border-b border-[#262626] bg-[#0a0a0a]/90 px-6 py-4 flex items-center justify-between font-mono text-xs">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#e5e5e5] animate-ping"></span>
        <span class="text-[#e5e5e5] font-bold tracking-widest">SECTOR // 00 — THE ABYSS</span>
      </div>
      <div class="flex items-center gap-4 text-[#737373]">
        <span class="hidden sm:inline">DEPTH: -404M BELOW NIGHT CITY</span>
        <a
          href="/"
          class="px-3.5 py-1.5 rounded-lg border border-[#333333] bg-[#111111] text-[#e5e5e5] hover:border-[#e5e5e5] hover:bg-[#1a1a1a] transition-all duration-300"
        >
          &uarr; RETURN TO SURFACE
        </a>
      </div>
    </header>

    <!-- Center Secret Sanctum Content -->
    <section class="relative z-10 w-[94%] max-w-[1480px] mx-auto my-auto py-16 px-6 lg:px-16">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[#333333] bg-[#111111] text-[11px] font-mono text-[#a3a3a3] tracking-[0.25em] uppercase mb-8">
          <span>EASTER EGG UNLOCKED // VASKRONA PROTOCOL</span>
        </div>

        <div class="relative mx-auto w-28 h-28 mb-8 flex items-center justify-center">
          <div class="absolute inset-0 rounded-full border border-[#a3a3a3]/40 animate-ping opacity-30"></div>
          <div class="relative w-24 h-24 rounded-full border border-[#a3a3a3]/60 bg-[#0d0d0d] flex items-center justify-center shadow-[0_0_50px_rgba(229,229,229,0.2)]">
            <img src="/logo_vaskrona.png" alt="Vaskrona Core" class="w-14 h-14 object-contain logo-glow" />
          </div>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black font-display tracking-wider text-[#e5e5e5] mb-6">
          VASKRONA <span class="text-[#a3a3a3]">SANCTUM</span>
        </h1>

        <p class="text-sm sm:text-base text-[#a3a3a3] font-mono leading-relaxed mb-10 max-w-xl mx-auto">
          Selamat! Kamu menemukan jalur rahasia di balik reruntuhan Night City. Ini adalah ruang arsip bawah tanah milik <span class="text-[#e5e5e5] font-semibold">Hilmi Zaki R</span>.
        </p>

        <!-- Secret Terminal Console Box -->
        <div class="text-left rounded-2xl border border-[#262626] bg-[#0a0a0a]/95 overflow-hidden shadow-2xl">
          <div class="px-4 py-2.5 border-b border-[#262626] bg-[#111111] flex items-center justify-between text-[11px] font-mono text-[#737373]">
            <span>TERMINAL // VASKRONA_CORE.SH</span>
            <span>ACCESS: GRANTED</span>
          </div>
          <div class="p-6 font-mono text-xs sm:text-sm space-y-3 text-[#a3a3a3]">
            <p><span class="text-[#525252]">$</span> whoami</p>
            <p class="text-[#e5e5e5] pl-4">&gt; Hilmi Zaki R — Software Engineer, UI/UX Designer, Night City Breaker.</p>
            <p><span class="text-[#525252]">$</span> cat secret_transmission.txt</p>
            <p class="text-[#e5e5e5] pl-4">&gt; "Rasa ingin tahu adalah awal dari setiap penemuan besar. Terima kasih sudah menjelajahi portofolio ini sampai ke titik terdalam."</p>
            <p class="pt-2"><span class="text-[#525252]">$</span> <span class="inline-block w-2 h-4 bg-[#e5e5e5] animate-pulse align-middle"></span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Bar -->
    <footer class="relative z-10 w-[94%] max-w-[1480px] mx-auto border-x border-t border-[#262626] bg-[#0a0a0a]/90 px-6 py-4 flex items-center justify-between font-mono text-[11px] text-[#525252]">
      <span>COORDINATES // SUB-LEVEL 99</span>
      <span>VASKRONA SECRET ARCHIVE</span>
    </footer>
  </main>
</Layout>

