---
import Layout from '../layouts/Layout.astro';
import AvatarCanvas from '../components/avatar/AvatarCanvas.astro';
import '../styles/global.css';
---

<Layout title="VOID // VASKRONA COMMAND & CRASH SITE">
  <main class="relative w-screen min-h-screen lg:h-screen bg-[#020202] text-[#e5e5e5] overflow-x-hidden lg:overflow-hidden select-none flex flex-col justify-between">
    <!-- Pure Pitch-Black Void Vignette -->
    <div class="pointer-events-none fixed inset-0 shadow-[inset_0_0_160px_rgba(0,0,0,0.98)]"></div>

    <!-- Subtle Dust Particles Floating in the Dark -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden opacity-25">
      <div class="dust-particle particle-1"></div>
      <div class="dust-particle particle-2"></div>
      <div class="dust-particle particle-3"></div>
      <div class="dust-particle particle-4"></div>
      <div class="dust-particle particle-5"></div>
    </div>

    <!-- ========================================================
         TOP: ORGANIC CEILING BREACH HOLE & SPIDERWEB FRACTURE CRACKS
         ======================================================== -->
    <div class="relative z-20 w-full flex flex-col items-center pt-0 pointer-events-none shrink-0">
      <!-- Organic Ceiling Crater & Branching Fracture Network (No Box / Slab Border) -->
      <div class="relative w-full max-w-[920px] px-2 pointer-events-none">
        <svg class="w-full h-32 sm:h-40 overflow-visible" viewBox="0 0 900 210" fill="none">
          <defs>
            <!-- Soft Radial Light Spill from the Hole -->
            <radialGradient id="breachLightSpill" cx="50%" cy="18%" r="52%" fx="50%" fy="12%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.16" />
              <stop offset="45%" stop-color="#a3a3a3" stop-opacity="0.05" />
              <stop offset="100%" stop-color="#000000" stop-opacity="0" />
            </radialGradient>

            <!-- Inner Rim Glow Gradient -->
            <radialGradient id="holeInnerGlow" cx="50%" cy="45%" r="50%">
              <stop offset="0%" stop-color="#050505" stop-opacity="1" />
              <stop offset="72%" stop-color="#0a0a0a" stop-opacity="1" />
              <stop offset="100%" stop-color="#e5e5e5" stop-opacity="0.28" />
            </radialGradient>

            <!-- Crack Fade Gradients -->
            <linearGradient id="crackLeft" x1="450" y1="30" x2="40" y2="90" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#d4d4d4" stop-opacity="0.9" />
              <stop offset="50%" stop-color="#737373" stop-opacity="0.65" />
              <stop offset="100%" stop-color="#262626" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="crackRight" x1="450" y1="30" x2="860" y2="90" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#d4d4d4" stop-opacity="0.9" />
              <stop offset="50%" stop-color="#737373" stop-opacity="0.65" />
              <stop offset="100%" stop-color="#262626" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="crackDown" x1="450" y1="40" x2="450" y2="195" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#a3a3a3" stop-opacity="0.85" />
              <stop offset="60%" stop-color="#525252" stop-opacity="0.45" />
              <stop offset="100%" stop-color="#1a1a1a" stop-opacity="0" />
            </linearGradient>
          </defs>

          <!-- Soft Ambient Glow Around the Ceiling Breach -->
          <ellipse cx="450" cy="42" rx="340" ry="135" fill="url(#breachLightSpill)" />

          <!-- Concentric Shockwave Ring Cracks (Webbing around the hole) -->
          <path
            d="M 278 24 L 296 58 L 348 82 L 415 92 L 486 90 L 552 78 L 602 52 L 620 20"
            stroke="#333333"
            stroke-width="1"
            stroke-dasharray="10 6 4 6"
            fill="none"
          />
          <path
            d="M 215 36 L 248 82 L 320 114 L 410 126 L 498 124 L 580 108 L 648 76 L 682 32"
            stroke="#242424"
            stroke-width="0.8"
            stroke-dasharray="14 8 3 9"
            fill="none"
          />

          <!-- PRIMARY RADIAL FRACTURE CRACKS (LEFT SIDE) -->
          <path
            d="M 342 28 L 308 35 L 284 26 L 246 42 L 212 38 L 174 56 L 132 49 L 94 68 L 48 62 L 12 76"
            stroke="url(#crackLeft)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M 308 35 L 288 54 L 256 68 L 228 88 L 192 96" stroke="url(#crackLeft)" stroke-width="1.3" stroke-linecap="round" />
          <path d="M 246 42 L 225 22 L 188 16 L 154 6" stroke="url(#crackLeft)" stroke-width="1.1" stroke-linecap="round" />
          <path d="M 174 56 L 152 80 L 116 94 L 82 115" stroke="url(#crackLeft)" stroke-width="1" stroke-linecap="round" />
          <path d="M 256 68 L 242 95 L 218 118" stroke="#404040" stroke-width="0.75" stroke-linecap="round" />
          <path d="M 132 49 L 108 32 L 74 28" stroke="#404040" stroke-width="0.7" stroke-linecap="round" />

          <!-- Lower-Left Diagonal Artery -->
          <path
            d="M 366 48 L 344 72 L 312 86 L 286 114 L 244 128 L 208 152 L 166 164"
            stroke="url(#crackDown)"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M 312 86 L 274 92 L 240 106" stroke="#525252" stroke-width="1" stroke-linecap="round" />
          <path d="M 344 72 L 352 102 L 336 128" stroke="#404040" stroke-width="0.85" stroke-linecap="round" />

          <!-- PRIMARY RADIAL FRACTURE CRACKS (RIGHT SIDE) -->
          <path
            d="M 558 26 L 594 34 L 622 24 L 660 40 L 698 35 L 738 54 L 782 48 L 824 66 L 868 60 L 892 72"
            stroke="url(#crackRight)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M 594 34 L 616 54 L 650 66 L 682 88 L 720 96" stroke="url(#crackRight)" stroke-width="1.3" stroke-linecap="round" />
          <path d="M 660 40 L 684 20 L 722 14 L 758 5" stroke="url(#crackRight)" stroke-width="1.1" stroke-linecap="round" />
          <path d="M 738 54 L 762 78 L 798 92 L 836 112" stroke="url(#crackRight)" stroke-width="1" stroke-linecap="round" />
          <path d="M 650 66 L 666 94 L 690 116" stroke="#404040" stroke-width="0.75" stroke-linecap="round" />
          <path d="M 782 48 L 806 30 L 842 24" stroke="#404040" stroke-width="0.7" stroke-linecap="round" />

          <!-- Lower-Right Diagonal Artery -->
          <path
            d="M 534 46 L 558 70 L 592 84 L 620 112 L 664 126 L 702 150 L 742 162"
            stroke="url(#crackDown)"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M 592 84 L 630 90 L 666 104" stroke="#525252" stroke-width="1" stroke-linecap="round" />
          <path d="M 558 70 L 548 100 L 564 128" stroke="#404040" stroke-width="0.85" stroke-linecap="round" />

          <!-- CENTER DOWNWARD FRACTURE ARTERIES -->
          <path d="M 405 58 L 394 88 L 406 116 L 390 148 L 398 178" stroke="url(#crackDown)" stroke-width="1.5" stroke-linecap="round" />
          <path d="M 394 88 L 372 108 L 358 134" stroke="#404040" stroke-width="0.9" stroke-linecap="round" />
          <path d="M 495 58 L 508 86 L 496 114 L 512 146 L 504 176" stroke="url(#crackDown)" stroke-width="1.5" stroke-linecap="round" />
          <path d="M 508 86 L 530 106 L 544 132" stroke="#404040" stroke-width="0.9" stroke-linecap="round" />
          <path d="M 450 62 L 446 94 L 456 122 L 448 156" stroke="url(#crackDown)" stroke-width="1.2" stroke-linecap="round" />

          <!-- OUTER SHATTERED CRATER LEDGE (3D Broken Rock Rim) -->
          <path
            d="M 326 14
               L 342 28
               L 354 40
               L 366 48
               L 388 52
               L 405 58
               L 428 56
               L 450 62
               L 474 55
               L 495 58
               L 516 50
               L 534 46
               L 548 38
               L 558 26
               L 574 14
               L 546 4
               L 508 8
               L 472 2
               L 450 6
               L 426 2
               L 390 8
               L 352 4 Z"
            fill="#121212"
            stroke="#525252"
            stroke-width="1.5"
            stroke-linejoin="round"
          />

          <!-- INNER BREACH ABYSS HOLE (Where the rocket punched through) -->
          <path
            d="M 346 18
               L 360 30
               L 376 36
               L 394 44
               L 418 42
               L 442 48
               L 462 46
               L 484 42
               L 506 44
               L 524 35
               L 540 28
               L 554 18
               L 532 8
               L 498 12
               L 468 7
               L 450 11
               L 430 7
               L 398 12
               L 368 8 Z"
            fill="url(#holeInnerGlow)"
            stroke="#e5e5e5"
            stroke-width="1.8"
            stroke-linejoin="round"
          />

          <!-- Deep Core Void & Dashed Rim Highlight -->
          <ellipse cx="450" cy="24" rx="82" ry="14" fill="#000000" stroke="#a3a3a3" stroke-width="1.2" stroke-dasharray="6 4" />
          <ellipse cx="450" cy="24" rx="56" ry="8" fill="#e5e5e5" fill-opacity="0.16" />

          <!-- Small Detached Rock Shards Around the Breach -->
          <polygon points="318,46 326,42 323,52" fill="#1f1f1f" stroke="#525252" stroke-width="0.8" />
          <polygon points="580,44 589,40 585,50" fill="#1f1f1f" stroke="#525252" stroke-width="0.8" />
          <polygon points="374,66 382,63 379,72" fill="#171717" stroke="#404040" stroke-width="0.8" />
          <polygon points="522,64 530,61 527,70" fill="#171717" stroke="#404040" stroke-width="0.8" />
        </svg>
      </div>

      <!-- GAME-STYLE ENTRY/EXIT MARKER NEAR THE BREACH HOLE (ICON ONLY) -->
      <a
        href="/"
        id="surface-escape-marker"
        class="group relative z-30 -mt-14 sm:-mt-18 flex flex-col items-center cursor-pointer pointer-events-auto animate-bounce"
        aria-label="Return to Surface"
      >
        <div class="relative flex items-center justify-center w-8 h-8">
          <span class="absolute inset-0 rounded-full border border-[#e5e5e5]/50 animate-ping"></span>
          <div class="w-7 h-7 rotate-45 rounded-[3px] border-2 border-[#e5e5e5] bg-[#0a0a0a] flex items-center justify-center shadow-[0_0_20px_#e5e5e5] group-hover:bg-[#e5e5e5] group-hover:scale-115 transition-all duration-300">
            <svg class="w-3.5 h-3.5 -rotate-45 text-[#e5e5e5] group-hover:text-[#0a0a0a] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
          </div>
        </div>
      </a>
    </div>

    <!-- ========================================================
         BOTTOM CAVERN FLOOR:
         - LEFT SIDE: 3D ROBLOX AVATAR (VASKRONA) CODING AT MULTI-MONITOR STATION
         - RIGHT SIDE: CRASHED VASKRONA ROCKET EMBEDDED IN RUBBLE
         ======================================================== -->
    <div class="relative z-20 flex-1 w-full max-w-[1540px] mx-auto px-4 sm:px-8 lg:px-14 pb-4 sm:pb-6 flex flex-col lg:flex-row items-center lg:items-end justify-between gap-8 pointer-events-none">
      <!-- LEFT SIDE: VASKRONA 3D ROBLOX AVATAR + BIG SCREEN & SMALL SCREENS -->
      <div class="w-full lg:w-[58%] flex justify-center lg:justify-start pointer-events-auto">
        <AvatarCanvas />
      </div>

      <!-- RIGHT SIDE: CRASHED VASKRONA ROCKET (SAME MODEL AS CUTSCENE) -->
      <div
        id="crashed-rocket-zone"
        class="relative z-30 flex flex-col items-center pointer-events-auto cursor-pointer group shrink-0 lg:mr-6"
      >
        <!-- Animated Rising Smoke Wisps from the Damaged Rocket -->
        <div class="pointer-events-none absolute -top-12 left-1/2 -translate-x-1/2 w-32 h-24">
          <div class="smoke-wisp smoke-1"></div>
          <div class="smoke-wisp smoke-2"></div>
          <div class="smoke-wisp smoke-3"></div>
        </div>

        <!-- Rocket Wreckage Container -->
        <div class="relative w-56 sm:w-72 h-44 sm:h-52 flex items-end justify-center">
          <!-- Subtle Impact Glow Under the Crater -->
          <div class="pointer-events-none absolute bottom-3 w-32 h-8 bg-white/10 rounded-full blur-xl animate-pulse"></div>

          <!-- EXACT VASKRONA ROCKET FROM CUTSCENE — NOSE-DOWN CRASHED & DAMAGED -->
          <div class="relative mb-3 mr-2 rotate-[146deg] transition-transform duration-300 group-hover:rotate-[144deg]">
            <!-- Damaged / Broken Targeting HUD Ring Fragment (from Cutscene Rocket) -->
            <div class="pointer-events-none absolute -inset-3 rounded-full border border-dashed border-[#e5e5e5]/20 [clip-path:polygon(0_0,100%_0,75%_65%,0_40%)]"></div>

            <!-- Intermittent Electrical Sparks on Damaged Hull -->
            <div class="spark-fx spark-a"></div>
            <div class="spark-fx spark-b"></div>

            <!-- Aerodynamic Rocket Nose Cone, Fuselage & Fins SVG (Same 120x150 viewBox as Hero.astro) -->
            <svg class="w-28 h-36 sm:w-32 sm:h-40 overflow-visible drop-shadow-[0_0_20px_rgba(229,229,229,0.22)]" viewBox="0 0 120 150" fill="none">
              <!-- Left Wing Fin (Bent & Cracked from Impact) -->
              <polygon points="24,88 4,122 18,123 30,114" fill="#161616" stroke="#a3a3a3" stroke-width="1.5" />
              <path d="M 15 104 L 24 110 L 20 118" stroke="#525252" stroke-width="1.2" />

              <!-- Right Wing Fin (Shattered / Broken Tip) -->
              <polygon points="96,88 112,114 102,118 90,114" fill="#161616" stroke="#e5e5e5" stroke-width="1.5" />

              <!-- Main Rocket Fuselage (Exact curve from Hero.astro) -->
              <path
                d="M60 6 C84 34 94 68 92 114 L28 114 C26 68 36 34 60 6 Z"
                fill="#0e0e0e"
                stroke="#e5e5e5"
                stroke-width="2"
              />

              <!-- Scorch / Impact Darkening at the Buried Nose Cone -->
              <path
                d="M60 6 C74 22 83 40 87 58 L33 58 C37 40 46 22 60 6 Z"
                fill="#050505"
                fill-opacity="0.75"
              />

              <!-- Original Inner Fuselage Tech Lines -->
              <path d="M60 6 L60 28 M36 52 L84 52 M32 104 L88 104" stroke="#525252" stroke-width="1" />

              <!-- Hull Fracture Cracks & Battle Damage on Fuselage -->
              <path
                d="M 48 34 L 58 46 L 52 58 L 66 70 L 61 84"
                stroke="#e5e5e5"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M 58 46 L 72 42 L 80 50"
                stroke="#a3a3a3"
                stroke-width="1"
                stroke-linecap="round"
              />
              <path
                d="M 34 78 L 46 86 L 42 98 L 54 104"
                stroke="#a3a3a3"
                stroke-width="1.1"
                stroke-linecap="round"
              />
              <path
                d="M 88 82 L 75 90 L 79 102"
                stroke="#737373"
                stroke-width="1"
                stroke-linecap="round"
              />

              <!-- Thruster Nozzle (Tilted / Cracked from Crash) -->
              <polygon
                points="42,114 78,114 82,126 34,124"
                fill="#202020"
                stroke="#a3a3a3"
                stroke-width="1.5"
              />
              <path d="M 54 114 L 50 125 M 68 114 L 71 125" stroke="#525252" stroke-width="1" />

              <!-- Dying Sputtering Afterburner Ember at Tail Nozzle -->
              <ellipse cx="58" cy="128" rx="12" ry="4" fill="#e5e5e5" fill-opacity="0.35" class="animate-pulse" />
            </svg>

            <!-- Vaskrona Logo Inside the Rocket Core -->
            <img
              src="/logo_vaskrona.png"
              alt="Vaskrona Rocket Core"
              class="absolute top-12 left-1/2 -translate-x-1/2 w-12 h-12 object-contain logo-glow opacity-80 rotate-180"
            />
          </div>

          <!-- FOREGROUND IMPACT CRATER, SHATTERED FIN PIECE & GROUND CRACKS -->
          <svg class="absolute bottom-0 inset-x-0 w-full h-24 overflow-visible pointer-events-none" viewBox="0 0 280 95" fill="none">
            <path
              d="M 145 58 L 96 64 L 62 56 L 24 68 L -18 62 L -55 74"
              stroke="#525252"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <path d="M 96 64 L 74 78 L 38 84" stroke="#333333" stroke-width="1.1" stroke-linecap="round" />
            <path d="M 62 56 L 44 44 L 15 48" stroke="#262626" stroke-width="0.9" stroke-linecap="round" />
            <path
              d="M 175 58 L 214 66 L 246 58 L 278 70"
              stroke="#525252"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path d="M 214 66 L 232 82 L 260 88" stroke="#333333" stroke-width="1" stroke-linecap="round" />
            <path d="M 155 64 L 132 82 L 108 92" stroke="#404040" stroke-width="1.3" stroke-linecap="round" />
            <path d="M 168 64 L 188 80 L 204 92" stroke="#404040" stroke-width="1.2" stroke-linecap="round" />

            <!-- Deep Impact Crater Pit -->
            <ellipse cx="158" cy="58" rx="54" ry="12" fill="#050505" stroke="#525252" stroke-width="1.4" stroke-dasharray="6 3" />

            <!-- Jagged Rubble Mound & Soil Chunks Burying the Rocket Nose -->
            <polygon points="104,60 122,40 142,58" fill="#121212" stroke="#525252" stroke-width="1.3" stroke-linejoin="round" />
            <polygon points="128,62 152,32 176,60" fill="#181818" stroke="#737373" stroke-width="1.5" stroke-linejoin="round" />
            <polygon points="160,62 184,36 206,58" fill="#141414" stroke="#525252" stroke-width="1.4" stroke-linejoin="round" />
            <polygon points="188,60 204,44 218,60" fill="#101010" stroke="#404040" stroke-width="1.2" stroke-linejoin="round" />
            <polygon points="116,64 138,48 162,64" fill="#0d0d0d" stroke="#404040" stroke-width="1.2" stroke-linejoin="round" />

            <!-- Severed Rocket Fin Tip Lying in the Debris on the Left -->
            <polygon points="68,58 82,46 88,56 74,62" fill="#1a1a1a" stroke="#a3a3a3" stroke-width="1.2" />

            <!-- Scattered Small Rock Shards -->
            <polygon points="48,66 55,60 60,67" fill="#171717" stroke="#404040" stroke-width="1" />
            <polygon points="224,64 232,57 237,65" fill="#171717" stroke="#404040" stroke-width="1" />
            <polygon points="144,72 152,66 157,74" fill="#1a1a1a" stroke="#525252" stroke-width="1" />
          </svg>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* ========================================================
     ATMOSPHERIC DUST PARTICLES
     ======================================================== */
  .dust-particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: #ffffff;
    border-radius: 50%;
    filter: blur(0.5px);
    animation: drift 16s infinite linear;
  }
  .particle-1 { top: 22%; left: 38%; animation-duration: 18s; opacity: 0.25; }
  .particle-2 { top: 38%; left: 54%; animation-duration: 15s; opacity: 0.35; }
  .particle-3 { top: 58%; left: 46%; animation-duration: 22s; opacity: 0.2; }
  .particle-4 { top: 28%; left: 62%; animation-duration: 13s; opacity: 0.3; }
  .particle-5 { top: 68%; left: 72%; animation-duration: 19s; opacity: 0.25; }

  @keyframes drift {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    20% { opacity: 0.45; }
    80% { opacity: 0.35; }
    100% { transform: translateY(-70px) translateX(24px); opacity: 0; }
  }

  /* ========================================================
     ANIMATED SMOKE WISPS FROM CRASHED ROCKET
     ======================================================== */
  .smoke-wisp {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 22px;
    height: 22px;
    background: radial-gradient(circle, rgba(229,229,229,0.28) 0%, rgba(163,163,163,0.08) 55%, transparent 80%);
    border-radius: 50%;
    filter: blur(5px);
    animation: smokeRise 4.2s infinite ease-out;
  }
  .smoke-1 { animation-delay: 0s; margin-left: -10px; }
  .smoke-2 { animation-delay: 1.4s; margin-left: 6px; width: 28px; height: 28px; }
  .smoke-3 { animation-delay: 2.8s; margin-left: -22px; width: 32px; height: 32px; }

  @keyframes smokeRise {
    0% {
      transform: translateY(20px) scale(0.5);
      opacity: 0.55;
    }
    50% {
      opacity: 0.3;
      transform: translateY(-30px) translateX(-12px) scale(1.4);
    }
    100% {
      transform: translateY(-85px) translateX(-26px) scale(2.3);
      opacity: 0;
    }
  }

  /* ========================================================
     INTERMITTENT CIRCUIT SPARKS ON DAMAGED HULL
     ======================================================== */
  .spark-fx {
    position: absolute;
    z-index: 20;
    width: 3px;
    height: 3px;
    background: #ffffff;
    box-shadow: 0 0 8px #ffffff, 0 0 14px #e5e5e5;
    border-radius: 50%;
    opacity: 0;
  }
  .spark-a {
    top: 42%;
    left: 26%;
    animation: sparkFlicker 3.2s infinite steps(1);
  }
  .spark-b {
    top: 66%;
    right: 24%;
    animation: sparkFlicker 4.6s infinite steps(1) 1.5s;
  }

  @keyframes sparkFlicker {
    0%, 92%, 100% { opacity: 0; transform: scale(0.5); }
    93% { opacity: 1; transform: scale(1.7) translate(-2px, -2px); }
    95% { opacity: 0; }
    97% { opacity: 0.9; transform: scale(1.3) translate(2px, 1px); }
    98% { opacity: 0; }
  }
</style>

<script>
  const crashedZone = document.getElementById('crashed-rocket-zone');
  if (crashedZone) {
    crashedZone.addEventListener('click', () => {
      crashedZone.classList.add('animate-pulse');
      setTimeout(() => {
        crashedZone.classList.remove('animate-pulse');
      }, 600);
    });
  }
</script>
