</footer>

<script>
  const footerRoot = document.getElementById('footer-root');
  const cityScene = document.getElementById('night-city-scene');
  const searchlight1 = document.getElementById('city-searchlight-1');
  const searchlight2 = document.getElementById('city-searchlight-2');
  const cityWindows = document.querySelectorAll('.city-window');
  const cityCenterIntact = document.getElementById('city-center-intact');
  const cityCenterDestroyed = document.getElementById('city-center-destroyed');
  const cityStatusText = document.getElementById('city-status-text');
  const cityHintText = document.getElementById('city-hint-text');
  const cityPowerDot = document.getElementById('city-power-dot');
  const footerCenterSocials = document.getElementById('footer-center-socials');

  let isCityDestroyed = false;

  // Interactive Night City: Hovering/Clicking windows & moving searchlights with cursor
  cityWindows.forEach((win) => {
    win.addEventListener('mouseenter', () => {
      if (isCityDestroyed) return;
      win.classList.add('is-lit', 'bg-[#e5e5e5]', 'shadow-[0_0_10px_#e5e5e5]');
      win.classList.remove('bg-[#1a1a1a]');
    });

    win.addEventListener('click', () => {
      if (isCityDestroyed) return;
      if (win.classList.contains('is-lit')) {
        win.classList.remove('is-lit', 'bg-[#e5e5e5]', 'bg-[#d4d4d4]/80', 'bg-[#e5e5e5]/85', 'shadow-[0_0_10px_#e5e5e5]', 'shadow-[0_0_8px_#d4d4d488]', 'shadow-[0_0_8px_#e5e5e588]');
        win.classList.add('bg-[#1a1a1a]');
      } else {
        win.classList.add('is-lit', 'bg-[#e5e5e5]', 'shadow-[0_0_10px_#e5e5e5]');
        win.classList.remove('bg-[#1a1a1a]');
      }
    });
  });

  cityScene?.addEventListener('mousemove', (e) => {
    if (isCityDestroyed) return;
    const rect = cityScene.getBoundingClientRect();
    const relX = (e.clientX - rect.left) / rect.width - 0.5; // -0.5 to 0.5
    const angle1 = relX * 55 - 10;
    const angle2 = relX * 55 + 10;
    if (searchlight1) searchlight1.style.transform = `rotate(${angle1.toFixed(1)}deg)`;
    if (searchlight2) searchlight2.style.transform = `rotate(${angle2.toFixed(1)}deg)`;
  });

  // Ambient random window twinkle while Night City is intact
  const cityTwinkleInterval = setInterval(() => {
    if (isCityDestroyed || cityWindows.length === 0) return;
    const randIndex = Math.floor(Math.random() * cityWindows.length);
    const win = cityWindows[randIndex];
    win.classList.toggle('opacity-40');
  }, 350);

  // Listen for the Rocket Impact event from the Hero Cutscene!
  window.addEventListener('vaskrona:footer-crash', () => {
    isCityDestroyed = true;
    clearInterval(cityTwinkleInterval);

    footerRoot?.classList.add('is-destroyed');

    // Swap intact central towers with the breached crater + game portal marker
    cityCenterIntact?.classList.add('hidden');
    cityCenterDestroyed?.classList.remove('hidden');
    cityCenterDestroyed?.classList.add('flex');

    // Damage the center of the bottom footer bar too
    if (footerCenterSocials) {
      footerCenterSocials.innerHTML = `<span class="text-[11px] font-mono text-[#737373] line-through tracking-widest">[ SECTOR BREACHED // OFFLINE ]</span>`;
    }

    // Shut down all Night City lights & interactivity (Power Blackout)
    cityWindows.forEach((win) => {
      win.classList.remove(
        'is-lit',
        'bg-[#e5e5e5]',
        'bg-[#d4d4d4]/80',
        'bg-[#e5e5e5]/85',
        'shadow-[0_0_10px_#e5e5e5]',
        'shadow-[0_0_8px_#d4d4d488]',
        'shadow-[0_0_8px_#e5e5e588]',
        'cursor-pointer'
      );
      win.classList.add('bg-[#141414]', 'cursor-default');
    });

    if (cityStatusText) {
      cityStatusText.textContent = 'NIGHT CITY // CRITICAL IMPACT DETECTED — POWER OFFLINE';
    }
    if (cityHintText) {
      cityHintText.textContent = 'BREACH OPENED // CLICK PORTAL MARKER TO ENTER';
    }
    if (cityPowerDot) {
      cityPowerDot.classList.remove('animate-pulse', 'bg-[#e5e5e5]');
      cityPowerDot.classList.add('bg-[#525252]');
    }
  });
</script>
