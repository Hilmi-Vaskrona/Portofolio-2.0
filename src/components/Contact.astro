---
---

<section id="contact" class="relative overflow-hidden">
  <!-- Chanhdai Section Header Bar -->
  <div class="border-b border-[#262626] px-6 py-3 flex items-center justify-between text-xs font-mono text-[#525252] bg-[#0a0a0a]">
    <span>SEC // 06 &mdash; TRANSMISSION</span>
    <span>[ CONTACT.CHANNEL ]</span>
  </div>

  <!-- JackieZhang Kinetic Scroll Marquee Background -->
  <div class="pointer-events-none select-none overflow-hidden py-4 border-b border-[#262626]/60 bg-[#0d0d0d]">
    <div class="scroll-marquee-track whitespace-nowrap font-display text-3xl sm:text-5xl font-black tracking-widest text-[#1a1a1a] uppercase" data-marquee-speed="0.16">
      <span>INITIATE CONTACT &bull; COLLABORATE &bull; LET'S BUILD TOGETHER &bull; </span>
      <span>INITIATE CONTACT &bull; COLLABORATE &bull; LET'S BUILD TOGETHER &bull; </span>
    </div>
  </div>

  <div class="p-6 lg:p-12 relative">
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>

    <div class="mb-10 reveal velocity-skew">
      <p class="text-xs font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-2">Get In Touch</p>
      <h2 class="text-4xl lg:text-5xl font-black text-[#e5e5e5]">Contact <span class="text-[#a3a3a3]">Me</span></h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 border border-[#262626] rounded-2xl overflow-hidden bg-[#111111]/50">
      <!-- Left Info Panel -->
      <div class="lg:col-span-5 p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-[#262626] flex flex-col justify-between spotlight-card reveal">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded border border-[#262626] bg-[#0a0a0a] text-[11px] font-mono text-[#a3a3a3]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#e5e5e5] animate-pulse"></span>
            <span>DIRECT CHANNELS</span>
          </div>

          <h3 class="text-2xl font-bold text-[#e5e5e5]">Let's Talk</h3>
          <p class="text-sm text-[#a3a3a3] leading-relaxed">
            Punya project atau hanya ingin ngobrol? Jangan ragu untuk menghubungi saya.
          </p>

          <div class="space-y-4 pt-2">
            <a href="mailto:hilmi08zr@gmail.com" class="flex items-center gap-4 p-3 rounded-xl border border-[#262626] bg-[#0a0a0a]/80 hover:border-[#a3a3a3] transition-all duration-300 group">
              <div class="w-10 h-10 rounded-lg bg-[#161616] border border-[#262626] flex items-center justify-center text-[#a3a3a3] group-hover:text-[#e5e5e5] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-[#525252] font-mono uppercase">Email</p>
                <p class="text-sm text-[#a3a3a3] group-hover:text-[#e5e5e5] transition-colors">hilmi08zr@gmail.com</p>
              </div>
            </a>

            <div class="flex items-center gap-4 p-3 rounded-xl border border-[#262626] bg-[#0a0a0a]/80 group">
              <div class="w-10 h-10 rounded-lg bg-[#161616] border border-[#262626] flex items-center justify-center text-[#a3a3a3]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-[#525252] font-mono uppercase">Phone</p>
                <p class="text-sm text-[#a3a3a3]">+62 812 3456 7890</p>
              </div>
            </div>

            <div class="flex items-center gap-4 p-3 rounded-xl border border-[#262626] bg-[#0a0a0a]/80 group">
              <div class="w-10 h-10 rounded-lg bg-[#161616] border border-[#262626] flex items-center justify-center text-[#a3a3a3]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-[10px] text-[#525252] font-mono uppercase">Location</p>
                <p class="text-sm text-[#a3a3a3]">Karawang, Jawa Barat</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-[#262626] text-[11px] font-mono text-[#525252]">
          RESPONSE TIME: &lt; 24 HOURS
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="lg:col-span-7 p-8 lg:p-10 bg-[#0d0d0d] spotlight-card reveal" style="--reveal-delay: 120ms;">
        <form action="https://formspree.io/f/myzwylba" method="POST" class="space-y-5 relative z-10">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-[11px] font-mono text-[#a3a3a3] uppercase mb-2">01 // Full Name</label>
              <input name="name" type="text" placeholder="Enter your name" required
                class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
            </div>
            <div>
              <label class="block text-[11px] font-mono text-[#a3a3a3] uppercase mb-2">02 // Email Address</label>
              <input name="email" type="email" placeholder="you@example.com" required
                class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-mono text-[#a3a3a3] uppercase mb-2">03 // Subject</label>
            <input name="subject" type="text" placeholder="Project inquiry / Collaboration"
              class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
          </div>
          <div>
            <label class="block text-[11px] font-mono text-[#a3a3a3] uppercase mb-2">04 // Message</label>
            <textarea name="message" placeholder="Tell me about your project..." rows="5" required
              class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300 resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full py-4 bg-[#e5e5e5] text-[#0a0a0a] font-mono font-bold rounded-xl hover:bg-[#a3a3a3] hover:shadow-[0_0_30px_#a3a3a344] transition-all duration-300 text-xs uppercase tracking-widest cursor-pointer">
            Send Transmission &rarr;
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
