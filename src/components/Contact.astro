---
---

<section id="contact" class="py-24 px-6 lg:px-[10%] relative">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-3">Get In Touch</p>
      <h2 class="text-5xl lg:text-6xl font-black text-[#e5e5e5]">Contact <span class="text-[#a3a3a3]">Me</span></h2>
      <div class="w-20 h-1 bg-[#a3a3a3] mx-auto mt-6 rounded-full shadow-[0_0_15px_#a3a3a366]"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <div class="lg:col-span-2 space-y-8 reveal">
        <h3 class="text-2xl font-bold text-[#e5e5e5]">Let's Talk</h3>
        <p class="text-[#a3a3a3] leading-relaxed">
          Punya project atau hanya ingin ngobrol? Jangan ragu untuk menghubungi saya.
        </p>

        <div class="space-y-6">
          <div class="flex items-center gap-4 group">
            <div class="w-12 h-12 rounded-xl bg-[#1a1a1a] border border-[#262626] flex items-center justify-center text-[#a3a3a3] group-hover:border-[#a3a3a3] group-hover:text-[#d4d4d4] transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-xs text-[#525252] font-mono">Email</p>
              <p class="text-sm text-[#a3a3a3] group-hover:text-[#e5e5e5] transition-colors">hilmi08zr@gmail.com</p>
            </div>
          </div>

          <div class="flex items-center gap-4 group">
            <div class="w-12 h-12 rounded-xl bg-[#1a1a1a] border border-[#262626] flex items-center justify-center text-[#a3a3a3] group-hover:border-[#a3a3a3] group-hover:text-[#d4d4d4] transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <p class="text-xs text-[#525252] font-mono">Phone</p>
              <p class="text-sm text-[#a3a3a3] group-hover:text-[#e5e5e5] transition-colors">+62 812 3456 7890</p>
            </div>
          </div>

          <div class="flex items-center gap-4 group">
            <div class="w-12 h-12 rounded-xl bg-[#1a1a1a] border border-[#262626] flex items-center justify-center text-[#a3a3a3] group-hover:border-[#a3a3a3] group-hover:text-[#d4d4d4] transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="text-xs text-[#525252] font-mono">Location</p>
              <p class="text-sm text-[#a3a3a3] group-hover:text-[#e5e5e5] transition-colors">Karawang, Jawa Barat</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-3 reveal">
        <form action="https://formspree.io/f/myzwylba" method="POST" class="space-y-5 p-8 rounded-2xl border border-[#262626] bg-[#111111]/80">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <input name="name" type="text" placeholder="Full Name" required
              class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
            <input name="email" type="email" placeholder="Email" required
              class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
          </div>
          <input name="subject" type="text" placeholder="Subject"
            class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300" />
          <textarea name="message" placeholder="Your Message" rows="6" required
            class="w-full px-4 py-3.5 bg-[#0a0a0a] border border-[#262626] rounded-xl text-sm text-[#e5e5e5] placeholder-[#525252] focus:outline-none focus:border-[#a3a3a3] focus:shadow-[0_0_15px_#a3a3a322] transition-all duration-300 resize-none"></textarea>
          <button type="submit"
            class="w-full py-4 bg-[#a3a3a3] text-[#0a0a0a] font-bold rounded-xl hover:bg-[#d4d4d4] hover:shadow-[0_0_30px_#a3a3a344] transition-all duration-300 text-sm uppercase tracking-wider cursor-pointer">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
