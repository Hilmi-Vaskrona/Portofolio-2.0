---
---

<div id="loading-screen" class="loading-screen">
  <div id="loading-logo" class="flex flex-col items-center gap-6 z-10">
    <div class="glitch-text">
      <img src="/logo_vaskrona.png" alt="Hilmi Logo" class="w-28 h-28 object-contain logo-glow" />
    </div>
    <div class="w-48 h-1 bg-[#262626] rounded-full overflow-hidden">
      <div id="loading-progress" class="h-full bg-[#a3a3a3] rounded-full shadow-[0_0_20px_#a3a3a3] transition-all duration-200" style="width: 0%"></div>
    </div>
    <span id="loading-percent" class="text-sm font-mono text-[#a3a3a3]">0%</span>
  </div>

  <div id="scanline-overlay" class="scanline-overlay"></div>
  <div id="dissolve-grid" class="dissolve-grid"></div>
</div>
