        </a>
        <a href="https://discord.com" target="_blank" class="w-12 h-12 flex items-center justify-center border border-[#262626] rounded-xl text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#a3a3a3] hover:shadow-[0_0_20px_#a3a3a333] transition-all duration-300 hover:-translate-y-1">
