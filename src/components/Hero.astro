---
const hiChars = ['H', 'i', ','];
const imChars = ["I", "'", 'm'];
const hilmiChars = ['H', 'i', 'l', 'm', 'i'];
---

<section id="home" class="relative pt-[4.75rem] overflow-hidden">
  <!-- Chanhdai Technical Top Sub-Bar -->
  <div class="border-b border-[#262626] bg-[#0a0a0a]/90 px-6 py-2.5 flex flex-wrap items-center justify-between gap-4 text-[11px] font-mono text-[#525252]">
    <div class="flex items-center gap-3">
      <span class="px-1.5 py-0.5 border border-[#262626] bg-[#111111] text-[#a3a3a3]">SYS // 001</span>
      <span>KARAWANG, ID &mdash; 6.3227&deg; S, 107.3376&deg; E</span>
    </div>
    <div class="flex items-center gap-4">
      <span id="hero-live-clock" class="text-[#a3a3a3]">UTC+7 // --:--:--</span>
      <span class="hidden sm:inline text-[#262626]">|</span>
      <span class="hidden sm:inline text-[#a3a3a3]">RPL &middot; SOFTWARE ENGINEER</span>
    </div>
  </div>

  <!-- Main Chanhdai Grid Cell for Hero -->
  <div id="hero-interactive-area" class="relative dot-matrix-bg px-6 py-16 lg:py-24 lg:px-12 overflow-hidden">
    <!-- Corner Crosshairs (+) -->
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>
    <span class="corner-plus -bottom-[5px] -left-[5px]"></span>
    <span class="corner-plus -bottom-[5px] -right-[5px]"></span>

    <!-- Ambient Monochrome Glow Orbs -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute top-[12%] left-[10%] w-72 h-72 bg-[#a3a3a3]/10 rounded-full blur-[120px]" data-scroll-speed="-0.15"></div>
      <div class="absolute bottom-[10%] right-[12%] w-96 h-96 bg-[#a3a3a3]/8 rounded-full blur-[140px]" data-scroll-speed="0.12"></div>
    </div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Title with JonasMosesson Kinetic Floating Elements -->
      <div class="lg:col-span-7 text-center lg:text-left lg:pl-8 xl:pl-14">
        <div class="mb-8 reveal lg:pl-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#262626] bg-[#111111]/90 text-xs font-mono text-[#a3a3a3] tracking-[0.25em] uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-[#a3a3a3] animate-ping"></span>
            <span>Welcome to my portfolio</span>
          </div>
        </div>

        <!-- JONASMOSESSON.SE INSPIRED KINETIC TITLE CLUSTER -->
        <div class="block mb-8">
          <div class="relative inline-block py-4 px-2 sm:px-3 select-none velocity-skew">
          <!-- Kinetic Element 1: Top-Left Rotating Spark + Floating Tag -->
          <div
            class="kinetic-el pointer-events-none absolute -top-7 -left-3 sm:-left-8 flex items-center gap-1.5 z-20"
            data-mouse-depth="28"
          >
            <div class="kinetic-float-1 flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-[#a3a3a3]/40 bg-[#111111]/95 shadow-[0_0_20px_#a3a3a322]">
              <svg class="w-3.5 h-3.5 text-[#e5e5e5] kinetic-spin" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
              </svg>
              <span class="text-[10px] font-mono tracking-widest text-[#e5e5e5]">CRAFT</span>
            </div>
          </div>

          <!-- Kinetic Element 2: Top-Right Orbiting Arcane Eye / Gyroscope -->
          <div
            class="kinetic-el pointer-events-none absolute -top-9 right-0 sm:-right-10 z-20"
            data-mouse-depth="-35"
          >
            <div class="kinetic-float-2 relative w-14 h-14 flex items-center justify-center">
              <svg class="w-full h-full text-[#a3a3a3]/50 kinetic-spin" viewBox="0 0 60 60" fill="none">
                <circle cx="30" cy="30" r="26" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" />
                <circle cx="30" cy="4" r="2.5" fill="#e5e5e5" />
                <circle cx="30" cy="56" r="2" fill="#a3a3a3" />
              </svg>
              <svg class="absolute w-7 h-7 text-[#e5e5e5] kinetic-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" />
                <circle cx="12" cy="12" r="2.5" fill="currentColor" />
              </svg>
            </div>
          </div>

          <!-- Kinetic Element 3: Bottom-Left Floating Code Node & Squiggle -->
          <div
            class="kinetic-el pointer-events-none absolute -bottom-6 left-2 sm:-left-6 z-20"
            data-mouse-depth="22"
          >
            <div class="kinetic-float-2 flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg border border-[#262626] bg-[#111111] flex items-center justify-center text-xs font-mono text-[#a3a3a3] shadow-lg">
                &lt;/&gt;
              </div>
              <svg class="w-16 h-5 text-[#a3a3a3]/60" viewBox="0 0 80 20" fill="none">
                <path
                  class="kinetic-draw"
                  d="M2 10 Q 12 2, 22 10 T 42 10 T 62 10 T 78 10"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </div>
          </div>

          <!-- Kinetic Element 4: Bottom-Right Geometric Prism & Cursor Coordinates -->
          <div
            class="kinetic-el pointer-events-none absolute -bottom-7 right-2 sm:-right-8 z-20"
            data-mouse-depth="-26"
          >
            <div class="kinetic-float-1 flex items-center gap-2 px-2.5 py-1 rounded-md border border-[#262626] bg-[#0a0a0a]/90 text-[10px] font-mono text-[#a3a3a3]">
              <svg class="w-3.5 h-3.5 text-[#e5e5e5] kinetic-spin-reverse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 22 12 12 22 2 12 12 2" />
              </svg>
              <span id="hero-cursor-coords">X:00 Y:00</span>
            </div>
          </div>

          <!-- Kinetic Element 5: Ambient Orbiting Ring Behind Title -->
          <svg
            class="kinetic-el pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[115%] h-[135%] text-[#a3a3a3]/15 -z-10"
            data-mouse-depth="14"
            viewBox="0 0 500 180"
            fill="none"
          >
            <ellipse cx="250" cy="90" rx="235" ry="68" stroke="currentColor" stroke-width="1" stroke-dasharray="6 8" transform="rotate(-4 250 90)" />
            <circle cx="480" cy="74" r="4" fill="#a3a3a3" class="kinetic-pulse" />
            <circle cx="20" cy="106" r="3" fill="#e5e5e5" class="kinetic-pulse" />
          </svg>

          <!-- Main Heading: "Hi, I'm Hilmi" -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight reveal">
            <span class="inline-block mr-3 text-[#e5e5e5]">
              {hiChars.map((ch, i) => (
                <span class="hero-char" style={`animation-delay: ${i * 60}ms`}>{ch}</span>
              ))}
            </span>
            <span class="inline-block mr-3 text-[#e5e5e5]">
              {imChars.map((ch, i) => (
                <span class="hero-char" style={`animation-delay: ${(i + 3) * 60}ms`}>{ch}</span>
              ))}
            </span>
            <span class="relative inline-block text-[#a3a3a3] drop-shadow-[0_0_35px_#a3a3a366]">
              {hilmiChars.map((ch, i) => (
                <span class="hero-char hero-name-char" style={`animation-delay: ${(i + 6) * 80}ms`}>{ch}</span>
              ))}<span class="text-[#e5e5e5]">.</span>
            </span>
          </h1>
          </div>
        </div>

        <!-- Typing Role Subtitle -->
        <div class="flex items-center justify-center lg:justify-start gap-3 text-lg sm:text-2xl text-[#a3a3a3] font-light mb-6 reveal lg:pl-3">
          <span class="font-mono text-xs px-2.5 py-1 rounded border border-[#262626] bg-[#111111] text-[#737373]">ROLE</span>
          <span>
            I'm a <span class="text-[#e5e5e5] font-semibold font-mono" id="typing-text"></span><span class="text-[#a3a3a3] animate-pulse">|</span>
          </span>
        </div>

        <p class="text-sm sm:text-base lg:text-lg text-[#a3a3a3] max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-8 reveal lg:pl-3">
          Suka mengubah ide jadi kenyataan di dunia digital. Dengan skill di teknologi dan desain, aku bikin sesuatu yang berfungsi, presisi, dan berkesan.
        </p>

        <!-- Action & Social Row (Chanhdai Crisp Buttons + Metalab Roll) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 reveal lg:pl-3">
          <a
            href="#portfolio"
            class="group relative inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-[#e5e5e5] text-[#0a0a0a] font-mono text-xs font-bold uppercase tracking-wider hover:bg-[#a3a3a3] transition-all duration-300 shadow-[0_0_25px_#a3a3a333]"
          >
            <span>Explore Works</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <div class="flex items-center gap-2">
            <a href="https://linkedin.com" target="_blank" aria-label="LinkedIn" class="spotlight-card w-11 h-11 flex items-center justify-center border border-[#262626] bg-[#111111]/80 rounded-xl text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 hover:-translate-y-1">
              <svg class="w-4 h-4 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://github.com" target="_blank" aria-label="GitHub" class="spotlight-card w-11 h-11 flex items-center justify-center border border-[#262626] bg-[#111111]/80 rounded-xl text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 hover:-translate-y-1">
              <svg class="w-4 h-4 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href="https://discord.com" target="_blank" aria-label="Discord" class="spotlight-card w-11 h-11 flex items-center justify-center border border-[#262626] bg-[#111111]/80 rounded-xl text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 hover:-translate-y-1">
              <svg class="w-4 h-4 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>
            <a href="https://x.com" target="_blank" aria-label="X" class="spotlight-card w-11 h-11 flex items-center justify-center border border-[#262626] bg-[#111111]/80 rounded-xl text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 hover:-translate-y-1">
              <svg class="w-4 h-4 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Chanhdai Technical Identity Card & Monolith Emblem -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end reveal" id="profile-photo">
        <div class="spotlight-card relative w-full max-w-md rounded-2xl border border-[#262626] bg-[#111111]/90 p-7 shadow-2xl group">
          <span class="corner-plus top-2 left-2"></span>
          <span class="corner-plus top-2 right-2"></span>
          <span class="corner-plus bottom-2 left-2"></span>
          <span class="corner-plus bottom-2 right-2"></span>

          <div class="flex items-center justify-between border-b border-[#262626] pb-3 mb-6 text-[11px] font-mono text-[#525252]">
            <span>ID // HZR-2025</span>
            <span class="text-[#a3a3a3]">STATUS: ACTIVE</span>
          </div>

          <!-- 3D Two-Sided Coin Container (Front: muka_saya.png, Back: logo_vaskrona.png) -->
          <div
            id="profile-coin"
            class="coin-scene relative mx-auto w-52 h-52 sm:w-60 sm:h-60"
            role="button"
            tabindex="0"
            aria-label="Hilmi Profile"
          >
            <div id="profile-coin-rotor" class="coin-rotor">
              <!-- Front Side (Default):Foto Profil (muka_saya.png) -->
              <div class="coin-face coin-face-front border-2 border-[#a3a3a3]/40 bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] shadow-[0_0_50px_#a3a3a322] group-hover:border-[#e5e5e5]/70 transition-colors duration-500">
                <img
                  src="/muka_saya.png"
                  alt="Foto Profil Hilmi"
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                />
                <!-- Subtle inner vignette & tech ring overlay -->
                <div class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset ring-white/15 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
                <svg class="pointer-events-none absolute inset-2 w-[calc(100%-16px)] h-[calc(100%-16px)] text-[#e5e5e5]/25 kinetic-spin" viewBox="0 0 100 100" fill="none">
                  <circle cx="50" cy="50" r="47" stroke="currentColor" stroke-width="0.6" stroke-dasharray="3 6" />
                </svg>
              </div>

              <!-- Back Side: Logo Vaskrona -->
              <div class="coin-face coin-face-back border-2 border-[#a3a3a3]/40 flex items-center justify-center bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] shadow-[0_0_50px_#a3a3a322] group-hover:border-[#e5e5e5]/70 transition-colors duration-500">
                <svg class="absolute inset-2 w-[calc(100%-16px)] h-[calc(100%-16px)] text-[#a3a3a3]/35 kinetic-spin" viewBox="0 0 100 100" fill="none">
                  <circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 5" />
                </svg>
                <img
                  src="/logo_vaskrona.png"
                  alt="Logo Vaskrona"
                  class="w-28 h-28 object-contain logo-glow transition-transform duration-500 group-hover:scale-110"
                />
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#262626] grid grid-cols-3 gap-2 text-center font-mono">
            <div class="p-2 rounded-lg bg-[#0a0a0a] border border-[#262626]/70">
              <p class="text-[10px] text-[#525252]">AGE</p>
              <p class="text-xs font-bold text-[#e5e5e5] mt-0.5">18 Y/O</p>
            </div>
            <div class="p-2 rounded-lg bg-[#0a0a0a] border border-[#262626]/70">
              <p class="text-[10px] text-[#525252]">FOCUS</p>
              <p class="text-xs font-bold text-[#e5e5e5] mt-0.5">WEB &amp; UI</p>
            </div>
            <div class="p-2 rounded-lg bg-[#0a0a0a] border border-[#262626]/70">
              <p class="text-[10px] text-[#525252]">PROJECTS</p>
              <p class="text-xs font-bold text-[#e5e5e5] mt-0.5">06+</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typing animation
  const typingElement = document.getElementById('typing-text');
  const words = ['Software Engineer', 'UI/UX Designer', 'Frontend Developer', 'Creative Thinker'];
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function typeEffect() {
    if (!typingElement) return;
    const currentWord = words[wordIndex];

    if (isDeleting) {
      typingElement.textContent = currentWord.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typingElement.textContent = currentWord.substring(0, charIndex + 1);
      charIndex++;
    }

    let timeout = isDeleting ? 45 : 95;

    if (!isDeleting && charIndex === currentWord.length) {
      timeout = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      timeout = 450;
    }

    setTimeout(typeEffect, timeout);
  }
  setTimeout(typeEffect, 900);

  // Live Clock in Chanhdai Top Bar
  const clockEl = document.getElementById('hero-live-clock');
  function updateClock() {
    if (!clockEl) return;
    const now = new Date();
    const timeStr = now.toLocaleTimeString('id-ID', { hour12: false });
    clockEl.textContent = `UTC+7 // ${timeStr}`;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // JonasMosesson-style Interactive Mouse Parallax for Kinetic Elements around "Hi, I'm Hilmi"
  const heroArea = document.getElementById('hero-interactive-area');
  const kineticEls = document.querySelectorAll('.kinetic-el');
  const coordsEl = document.getElementById('hero-cursor-coords');

  heroArea?.addEventListener('mousemove', (e) => {
    const rect = heroArea.getBoundingClientRect();
    const relX = (e.clientX - rect.left) / rect.width - 0.5;
    const relY = (e.clientY - rect.top) / rect.height - 0.5;

    if (coordsEl) {
      const xVal = Math.round((relX + 0.5) * 99).toString().padStart(2, '0');
      const yVal = Math.round((relY + 0.5) * 99).toString().padStart(2, '0');
      coordsEl.textContent = `X:${xVal} Y:${yVal}`;
    }

    kineticEls.forEach((el) => {
      const htmlEl = el as HTMLElement;
      const depth = parseFloat(htmlEl.dataset.mouseDepth || '20');
      const moveX = relX * depth;
      const moveY = relY * depth;
      htmlEl.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
    });
  });

  heroArea?.addEventListener('mouseleave', () => {
    kineticEls.forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.transition = 'transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)';
      htmlEl.style.transform = 'translate3d(0, 0, 0)';
      setTimeout(() => {
        htmlEl.style.transition = '';
      }, 600);
    });
  });

  // 3D Two-Sided Coin Flip (Front: muka_saya.png -> Back: logo_vaskrona.png)
  const profileCoin = document.getElementById('profile-coin');
  const coinRotor = document.getElementById('profile-coin-rotor');
  let coinDeg = 0;

  function flipProfileCoin() {
    if (!profileCoin || !coinRotor) return;
    coinDeg += 540; // 1.5 spins for a realistic 3D coin toss flip to the opposite face
    coinRotor.style.transform = `rotateY(${coinDeg}deg)`;

    profileCoin.classList.remove('is-flipping');
    void profileCoin.offsetWidth; // trigger reflow for bounce animation
    profileCoin.classList.add('is-flipping');
  }

  profileCoin?.addEventListener('click', flipProfileCoin);
  profileCoin?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      flipProfileCoin();
    }
  });
</script>
