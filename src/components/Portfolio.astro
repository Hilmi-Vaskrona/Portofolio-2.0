---
const projects = [
  {
    id: 'PRJ-01',
    title: 'Landing Page Bali.Tour',
    category: 'web',
    description: 'Website pariwisata Bali dengan desain modern dan responsif.',
    tech: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    id: 'PRJ-02',
    title: 'The Parfume',
    category: 'web',
    description: 'Situs web e-commerce untuk produk parfum premium.',
    tech: ['HTML', 'CSS', 'Tailwind'],
  },
  {
    id: 'PRJ-03',
    title: 'Sabun Kallos',
    category: 'web',
    description: 'Website e-commerce produk sabun skincare.',
    tech: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    id: 'PRJ-04',
    title: 'SMK MQ Landing Page',
    category: 'design',
    description: 'Desain landing page untuk SMK Madinatul Quran.',
    tech: ['Figma', 'UI/UX'],
  },
  {
    id: 'PRJ-05',
    title: 'Nostalgic Game Retro',
    category: 'design',
    description: 'Desain e-commerce untuk game retro dan nostalgia.',
    tech: ['Figma', 'UI/UX'],
  },
  {
    id: 'PRJ-06',
    title: 'Bukalapak Redesign',
    category: 'design',
    description: 'Redesign tampilan e-commerce Bukalapak.',
    tech: ['Figma', 'UI/UX'],
  },
];
---

<section id="portfolio" class="relative overflow-hidden">
  <!-- Chanhdai Section Header Bar -->
  <div class="border-b border-[#262626] px-6 py-3 flex items-center justify-between text-xs font-mono text-[#525252] bg-[#0a0a0a]">
    <span>SEC // 04 &mdash; SELECTED WORKS</span>
    <span>[ PROJECTS_REGISTRY ]</span>
  </div>

  <!-- JackieZhang Kinetic Scroll Marquee Background -->
  <div class="pointer-events-none select-none overflow-hidden py-4 border-b border-[#262626]/60 bg-[#0d0d0d]">
    <div class="scroll-marquee-track whitespace-nowrap font-display text-3xl sm:text-5xl font-black tracking-widest text-[#1a1a1a] uppercase" data-marquee-speed="0.22">
      <span>SELECTED PORTFOLIO &bull; WEB DEVELOPMENT &bull; UI/UX DESIGN &bull; </span>
      <span>SELECTED PORTFOLIO &bull; WEB DEVELOPMENT &bull; UI/UX DESIGN &bull; </span>
    </div>
  </div>

  <div class="p-6 lg:p-12 relative">
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal velocity-skew">
      <div>
        <p class="text-xs font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-2">My Work</p>
        <h2 class="text-4xl lg:text-5xl font-black text-[#e5e5e5]">Port<span class="text-[#a3a3a3]">folio</span></h2>
      </div>

      <!-- Filter Tabs with Metalab Roll Effect -->
      <div class="inline-flex items-center p-1 rounded-full border border-[#262626] bg-[#111111]/90 self-start sm:self-auto">
        <button class="filter-btn active px-5 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider border border-transparent text-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 cursor-pointer" data-filter="all">All</button>
        <button class="filter-btn px-5 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider border border-transparent text-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 cursor-pointer" data-filter="web">Web Dev</button>
        <button class="filter-btn px-5 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider border border-transparent text-[#a3a3a3] hover:text-[#e5e5e5] transition-all duration-300 cursor-pointer" data-filter="design">Design</button>
      </div>
    </div>

    <!-- Chanhdai Bento Grid for Projects -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="portfolio-grid">
      {projects.map((project, i) => (
        <div
          class="portfolio-card spotlight-card group relative rounded-2xl border border-[#262626] bg-[#111111]/80 overflow-hidden hover:border-[#a3a3a3]/50 hover:shadow-[0_0_40px_#a3a3a314] transition-all duration-500 reveal velocity-skew"
          data-category={project.category}
          style={`--reveal-delay: ${i * 70}ms;`}
        >
          <!-- Top Card Technical Bar -->
          <div class="px-5 py-2.5 border-b border-[#262626] bg-[#0a0a0a]/80 flex items-center justify-between text-[11px] font-mono text-[#525252]">
            <span>{project.id}</span>
            <span class="uppercase text-[#a3a3a3]">{project.category}</span>
          </div>

          <div class="aspect-video dot-matrix-bg bg-gradient-to-br from-[#161616] to-[#0a0a0a] flex items-center justify-center relative overflow-hidden border-b border-[#262626]">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent opacity-60"></div>
            <span class="text-7xl font-black font-display text-[#222222] group-hover:text-[#a3a3a3]/30 transition-all duration-500 group-hover:scale-110 transform select-none">
              {project.title.charAt(0)}
            </span>

            <!-- Guglieri Hover Corner Arrow Badge -->
            <div class="absolute bottom-3 right-3 w-9 h-9 rounded-full border border-[#262626] bg-[#111111]/90 flex items-center justify-center text-[#a3a3a3] opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
              <svg class="w-4 h-4 -rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>

          <div class="p-6 relative z-10">
            <h3 class="text-lg font-bold text-[#e5e5e5] group-hover:text-white transition-colors">{project.title}</h3>
            <p class="text-sm text-[#a3a3a3] mt-2 leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-[#262626]/60">
              {project.tech.map((t) => (
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-[#0a0a0a] text-[#a3a3a3] border border-[#262626]">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.style.display = 'block';
          el.style.opacity = '0';
          el.style.filter = 'blur(8px)';
          el.style.transform = 'translateY(20px) scale(0.96)';
          setTimeout(() => {
            el.style.transition = 'opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), filter 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1)';
            el.style.opacity = '1';
            el.style.filter = 'blur(0px)';
            el.style.transform = 'translateY(0) scale(1)';
          }, 40);
        } else {
          el.style.opacity = '0';
          el.style.filter = 'blur(8px)';
          el.style.transform = 'translateY(16px) scale(0.96)';
          setTimeout(() => { el.style.display = 'none'; }, 300);
        }
      });
    });
  });
</script>
