---
const projects = [
  {
    title: 'Landing Page Bali.Tour',
    category: 'web',
    description: 'Website pariwisata Bali dengan desain modern dan responsif.',
    tech: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    title: 'The Parfume',
    category: 'web',
    description: 'Situs web e-commerce untuk produk parfum premium.',
    tech: ['HTML', 'CSS', 'Tailwind'],
  },
  {
    title: 'Sabun Kallos',
    category: 'web',
    description: 'Website e-commerce produk sabun skincare.',
    tech: ['HTML', 'CSS', 'JavaScript'],
  },
  {
    title: 'SMK MQ Landing Page',
    category: 'design',
    description: 'Desain landing page untuk SMK Madinatul Quran.',
    tech: ['Figma', 'UI/UX'],
  },
  {
    title: 'Nonstalgic Game Retro',
    category: 'design',
    description: 'Desain e-commerce untuk game retro dan nostalgia.',
    tech: ['Figma', 'UI/UX'],
  },
  {
    title: 'Bukalapak Redesign',
    category: 'design',
    description: 'Redesign tampilan e-commerce Bukalapak.',
    tech: ['Figma', 'UI/UX'],
  },
];
---

<section id="portfolio" class="py-24 px-6 lg:px-[10%] relative">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-3">My Work</p>
      <h2 class="text-5xl lg:text-6xl font-black text-[#e5e5e5]">Port<span class="text-[#a3a3a3]">folio</span></h2>
      <div class="w-20 h-1 bg-[#a3a3a3] mx-auto mt-6 rounded-full shadow-[0_0_15px_#a3a3a366]"></div>
    </div>

    <div class="flex justify-center gap-4 mb-12 reveal">
      <button class="filter-btn active px-6 py-2 rounded-full text-sm font-medium border border-[#262626] text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#d4d4d4] transition-all duration-300" data-filter="all">All</button>
      <button class="filter-btn px-6 py-2 rounded-full text-sm font-medium border border-[#262626] text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#d4d4d4] transition-all duration-300" data-filter="web">Web Dev</button>
      <button class="filter-btn px-6 py-2 rounded-full text-sm font-medium border border-[#262626] text-[#a3a3a3] hover:border-[#a3a3a3] hover:text-[#d4d4d4] transition-all duration-300" data-filter="design">Design</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
      {projects.map((project) => (
        <div class="portfolio-card group relative rounded-2xl border border-[#262626] bg-[#111111]/80 overflow-hidden hover:border-[#a3a3a3]/40 hover:shadow-[0_0_40px_#a3a3a311] transition-all duration-500 reveal" data-category={project.category}>
          <div class="aspect-video bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent opacity-60"></div>
            <span class="text-6xl font-black text-[#262626] group-hover:text-[#a3a3a3]/20 transition-colors duration-500 group-hover:scale-110 transform">{project.title.charAt(0)}</span>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-[#e5e5e5] group-hover:text-[#d4d4d4] transition-colors">{project.title}</h3>
            <p class="text-sm text-[#a3a3a3] mt-2 leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-2 mt-4">
              {project.tech.map((t) => (
                <span class="text-xs font-mono px-3 py-1 rounded-full bg-[#1a1a1a] text-[#525252] border border-[#262626]">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.style.display = 'block';
          el.style.opacity = '0';
          el.style.transform = 'translateY(20px)';
          setTimeout(() => {
            el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }, 50);
        } else {
          el.style.opacity = '0';
          el.style.transform = 'translateY(20px)';
          setTimeout(() => { el.style.display = 'none'; }, 300);
        }
      });
    });
  });

  document.querySelector('.filter-btn.active')?.dispatchEvent(new Event('click'));
</script>
