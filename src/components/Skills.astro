const RING_RADIUS = 21;
const RING_CIRCUMFERENCE = Number((2 * Math.PI * RING_RADIUS).toFixed(1)); // 131.9
---

<section id="skills" class="relative overflow-x-clip overflow-y-visible">
  <!-- Chanhdai Section Header Bar -->
  <div class="border-b border-[#262626] px-6 py-3 flex items-center justify-between text-xs font-mono text-[#525252] bg-[#0a0a0a]">
    <span>SEC // 04 &mdash; CAPABILITIES</span>
    <span>[ SKILLS_MATRIX.SH ]</span>
  </div>

  <!-- JackieZhang Kinetic Scroll Marquee Background -->
  <div class="pointer-events-none select-none overflow-hidden py-4 border-b border-[#262626]/60 bg-[#0d0d0d]">
    <div class="scroll-marquee-track whitespace-nowrap font-display text-3xl sm:text-5xl font-black tracking-widest text-[#1a1a1a] uppercase" data-marquee-speed="0.18">
      <span>TECHNICAL SKILLS &bull; FULLSTACK &amp; UI/UX &bull; CONTINUOUSLY BUILDING &bull; </span>
      <span>TECHNICAL SKILLS &bull; FULLSTACK &amp; UI/UX &bull; CONTINUOUSLY BUILDING &bull; </span>
    </div>
  </div>

  <div class="p-6 lg:p-12 relative">
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>

    <div class="mb-4 reveal velocity-skew">
      <p class="text-xs font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-2">Tech Stack &amp; Mastery</p>
      <h2 class="text-4xl lg:text-5xl font-black text-[#e5e5e5]">Skills <span class="text-[#a3a3a3]">&amp;</span> Tools</h2>
    </div>

    <!-- Auto-Moving Infinite Skill Marquee Container (overflow-y-visible keeps hover bubblechats unclipped without blank padding) -->
    <div class="relative -mx-6 lg:-mx-12 pt-8 pb-4 space-y-5">
      <!-- Subtle Left/Right Vignette Fade -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-10 sm:w-20 bg-gradient-to-r from-[#0a0a0a] to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-10 sm:w-20 bg-gradient-to-l from-[#0a0a0a] to-transparent z-10"></div>

      <!-- ROW 1: Moves Left -->
      <div class="skills-marquee-row relative z-20 hover:z-40">
        <div class="skills-marquee-track track-left flex w-max">
          {[0, 1].map(() => (
            <div class="flex shrink-0 gap-4 sm:gap-5 pr-4 sm:pr-5">
              {row1Skills.map((skill) => {
                const targetOffset = (RING_CIRCUMFERENCE * (1 - skill.percent / 100)).toFixed(1);
                return (
                  <div
                    class="skill-card group relative shrink-0 w-64 sm:w-72 rounded-2xl border border-[#262626] bg-[#111111]/90 p-5 sm:p-6 flex items-center gap-4 cursor-pointer transition-all duration-300 hover:border-[#e5e5e5]/70 hover:bg-[#16161b] hover:-translate-y-1 hover:shadow-[0_0_28px_rgba(229,229,229,0.12)]"
                    tabindex="0"
                    data-percent={skill.percent}
                  >
                    <!-- Compact Hover Bubblechat with Circular Progress Bar & Center Percentage -->
                    <div class="skill-bubblechat" aria-hidden="true">
                      <p class="w-full text-center font-mono text-[10px] font-bold text-[#e5e5e5] truncate border-b border-[#262626] pb-1 mb-1.5">
                        {skill.name}
                      </p>
                      <div class="relative w-[52px] h-[52px] mx-auto flex items-center justify-center">
                        <svg class="w-[52px] h-[52px]" viewBox="0 0 52 52" fill="none">
                          <circle
                            cx="26"
                            cy="26"
                            r={RING_RADIUS}
                            stroke="#262626"
                            stroke-width="4"
                          />
                          <circle
                            class="skill-progress-ring"
                            cx="26"
                            cy="26"
                            r={RING_RADIUS}
                            stroke="#e5e5e5"
                            stroke-width="4"
                            stroke-linecap="round"
                            style={`--target-offset: ${targetOffset}; stroke-dasharray: ${RING_CIRCUMFERENCE};`}
                          />
                        </svg>
                        <span class="skill-percent-label absolute inset-0 flex items-center justify-center font-mono text-[11px] font-bold text-[#ffffff] tabular-nums">
                          {skill.percent}%
                        </span>
                      </div>
                    </div>

                    <!-- Skill Logo Container -->
                    <div class="w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-xl border border-[#262626] bg-[#0a0a0a] flex items-center justify-center shrink-0 group-hover:border-[#e5e5e5]/50 transition-colors duration-300">
                      <div class="w-10 h-10 sm:w-11 sm:h-11 [&_svg]:w-full [&_svg]:h-full flex items-center justify-center transition-transform duration-300 group-hover:scale-110" set:html={skill.iconSvg} />
                    </div>

                    <!-- Skill Label -->
                    <div class="min-w-0">
                      <h3 class="text-base sm:text-lg font-bold text-[#e5e5e5] group-hover:text-white truncate">{skill.name}</h3>
                      <p class="text-xs font-mono text-[#737373] group-hover:text-[#a3a3a3] truncate mt-0.5">{skill.category}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </div>

      <!-- ROW 2: Moves Right -->
      <div class="skills-marquee-row relative z-20 hover:z-40">
        <div class="skills-marquee-track track-right flex w-max">
          {[0, 1].map(() => (
            <div class="flex shrink-0 gap-4 sm:gap-5 pr-4 sm:pr-5">
              {row2Skills.map((skill) => {
                const targetOffset = (RING_CIRCUMFERENCE * (1 - skill.percent / 100)).toFixed(1);
                return (
                  <div
                    class="skill-card group relative shrink-0 w-64 sm:w-72 rounded-2xl border border-[#262626] bg-[#111111]/90 p-5 sm:p-6 flex items-center gap-4 cursor-pointer transition-all duration-300 hover:border-[#e5e5e5]/70 hover:bg-[#16161b] hover:-translate-y-1 hover:shadow-[0_0_28px_rgba(229,229,229,0.12)]"
                    tabindex="0"
                    data-percent={skill.percent}
                  >
                    <!-- Compact Hover Bubblechat with Circular Progress Bar & Center Percentage -->
                    <div class="skill-bubblechat" aria-hidden="true">
                      <p class="w-full text-center font-mono text-[10px] font-bold text-[#e5e5e5] truncate border-b border-[#262626] pb-1 mb-1.5">
                        {skill.name}
                      </p>
                      <div class="relative w-[52px] h-[52px] mx-auto flex items-center justify-center">
                        <svg class="w-[52px] h-[52px]" viewBox="0 0 52 52" fill="none">
                          <circle
                            cx="26"
                            cy="26"
                            r={RING_RADIUS}
                            stroke="#262626"
                            stroke-width="4"
                          />
                          <circle
                            class="skill-progress-ring"
                            cx="26"
                            cy="26"
                            r={RING_RADIUS}
                            stroke="#e5e5e5"
                            stroke-width="4"
                            stroke-linecap="round"
                            style={`--target-offset: ${targetOffset}; stroke-dasharray: ${RING_CIRCUMFERENCE};`}
                          />
                        </svg>
                        <span class="skill-percent-label absolute inset-0 flex items-center justify-center font-mono text-[11px] font-bold text-[#ffffff] tabular-nums">
                          {skill.percent}%
                        </span>
                      </div>
                    </div>

                    <!-- Skill Logo Container -->
                    <div class="w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-xl border border-[#262626] bg-[#0a0a0a] flex items-center justify-center shrink-0 group-hover:border-[#e5e5e5]/50 transition-colors duration-300">
                      <div class="w-10 h-10 sm:w-11 sm:h-11 [&_svg]:w-full [&_svg]:h-full flex items-center justify-center transition-transform duration-300 group-hover:scale-110" set:html={skill.iconSvg} />
                    </div>

                    <!-- Skill Label -->
                    <div class="min-w-0">
                      <h3 class="text-base sm:text-lg font-bold text-[#e5e5e5] group-hover:text-white truncate">{skill.name}</h3>
                      <p class="text-xs font-mono text-[#737373] group-hover:text-[#a3a3a3] truncate mt-0.5">{skill.category}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes skillsMarqueeLeft {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes skillsMarqueeRight {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .skills-marquee-track.track-left {
    animation: skillsMarqueeLeft 34s linear infinite;
    will-change: transform;
  }

  .skills-marquee-track.track-right {
    animation: skillsMarqueeRight 38s linear infinite;
    will-change: transform;
  }

  .skills-marquee-track:hover,
  .skills-marquee-track:focus-within {
    animation-play-state: paused;
  }

  .skill-card {
    z-index: 1;
  }

  .skill-card:hover,
  .skill-card:focus-within {
    z-index: 50;
  }

  /* Compact Skill Hover Bubblechat */
  .skill-bubblechat {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translate3d(-50%, 6px, 0) scale(0.92);
    width: 122px;
    padding: 7px 9px;
    border-radius: 9px;
    border: 1.5px solid #e5e5e5;
    background: rgba(10, 10, 14, 0.97);
    box-shadow:
      0 10px 24px rgba(0, 0, 0, 0.92),
      0 0 18px rgba(229, 229, 229, 0.14);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .skill-bubblechat::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 9px;
    height: 9px;
    background: #0a0a0e;
    border-right: 1.5px solid #e5e5e5;
    border-bottom: 1.5px solid #e5e5e5;
  }

  .skill-card:hover .skill-bubblechat,
  .skill-card:focus-within .skill-bubblechat {
    opacity: 1;
    transform: translate3d(-50%, 0, 0) scale(1);
  }

  .skill-progress-ring {
    stroke-dashoffset: 131.9;
    transition: stroke-dashoffset 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }

  .skill-card:hover .skill-progress-ring,
  .skill-card:focus-within .skill-progress-ring {
    stroke-dashoffset: var(--target-offset, 131.9);
  }
</style>

<script>
  // Smooth percentage count-up inside the circular progress bar on skill hover/focus
  const skillCards = document.querySelectorAll('.skill-card');

  skillCards.forEach((card) => {
    const target = parseInt(card.getAttribute('data-percent') || '0', 10);
    const labelEl = card.querySelector('.skill-percent-label');
    let rafId = 0;

    function animatePercentCountUp() {
      if (!labelEl) return;
      cancelAnimationFrame(rafId);
      const duration = 620;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(eased * target);
        if (labelEl) labelEl.textContent = `${current}%`;
        if (progress < 1) {
          rafId = requestAnimationFrame(tick);
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function resetPercentLabel() {
      cancelAnimationFrame(rafId);
      if (labelEl) labelEl.textContent = `${target}%`;
    }

    card.addEventListener('mouseenter', animatePercentCountUp);
    card.addEventListener('focusin', animatePercentCountUp);
    card.addEventListener('mouseleave', resetPercentLabel);
  });
</script>
