---

<section id="experience" class="py-24 px-6 lg:px-[10%] relative">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-3">My Journey</p>
      <h2 class="text-5xl lg:text-6xl font-black text-[#e5e5e5]">Experience <span class="text-[#a3a3a3]">&</span> Education</h2>
      <div class="w-20 h-1 bg-[#a3a3a3] mx-auto mt-6 rounded-full shadow-[0_0_15px_#a3a3a366]"></div>
    </div>

    <div class="relative">
      <div class="absolute left-6 lg:left-1/2 top-0 bottom-0 w-[2px] bg-gradient-to-b from-[#a3a3a3] via-[#262626] to-transparent transform -translate-x-1/2"></div>

      {timeline.map((item, i) => (
        <div class={`relative flex items-start gap-8 mb-12 reveal ${i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'}`}>
          <div class="hidden lg:block lg:w-1/2"></div>

          <div class="absolute left-6 lg:left-1/2 w-12 h-12 bg-[#0a0a0a] border-2 border-[#a3a3a3] rounded-full flex items-center justify-center text-xl transform -translate-x-1/2 z-10 shadow-[0_0_20px_#a3a3a333]" set:html={item.icon}>
          </div>

          <div class="ml-16 lg:ml-0 lg:w-1/2">
            <div class="p-6 rounded-2xl border border-[#262626] bg-[#111111]/80 hover:border-[#a3a3a3]/30 hover:shadow-[0_0_30px_#a3a3a311] transition-all duration-300 group">
              <span class="text-xs font-mono text-[#a3a3a3] tracking-wider">{item.year}</span>
              <h3 class="text-xl font-bold mt-2 text-[#e5e5e5] group-hover:text-[#d4d4d4] transition-colors">{item.title}</h3>
              <p class="text-sm text-[#525252] mt-1">{item.subtitle}</p>
              <p class="text-sm text-[#a3a3a3] mt-3 leading-relaxed">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
