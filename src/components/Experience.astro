<section id="experience" class="relative overflow-hidden">
  <!-- Chanhdai Section Header Bar -->
  <div class="border-b border-[#262626] px-6 py-3 flex items-center justify-between text-xs font-mono text-[#525252] bg-[#0a0a0a]">
    <span>SEC // 03 &mdash; TIMELINE</span>
    <div class="flex items-center gap-3">
      <span id="ygg-sky-badge" class="text-[11px] text-[#a3a3a3]">[ SKY // LIVE ]</span>
      <span>[ EXPERIENCE.LOG ]</span>
    </div>
  </div>

  <!-- JackieZhang Kinetic Scroll Marquee Background -->
  <div class="pointer-events-none select-none overflow-hidden py-4 border-b border-[#262626]/60 bg-[#0d0d0d]">
    <div class="scroll-marquee-track whitespace-nowrap font-display text-3xl sm:text-5xl font-black tracking-widest text-[#1a1a1a] uppercase" data-marquee-speed="-0.16">
      <span>EXPERIENCE &amp; EDUCATION &bull; MILESTONES &bull; JOURNEY &bull; </span>
      <span>EXPERIENCE &amp; EDUCATION &bull; MILESTONES &bull; JOURNEY &bull; </span>
    </div>
  </div>

  <div class="p-6 lg:p-12 relative">
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>

    <!-- Full-Section Real-Time Adaptive Sky Atmosphere (No Inner Box Clipping Lines) -->
    <div
      id="ygg-sky-atmosphere"
      class="pointer-events-none absolute inset-0 z-0 transition-opacity duration-1000"
    ></div>

    <!-- Full-Width Section Wind Breeze, Flying Birds & Drifting Leaves (Left Edge -> Right Edge) -->
    <div class="pointer-events-none absolute inset-0 z-25 overflow-hidden" aria-hidden="true">
      <svg
        class="w-full h-full"
        viewBox="0 0 1480 760"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="ygg-section-wind-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#a3a3a3" stop-opacity="0" />
            <stop offset="30%" stop-color="#e5e5e5" stop-opacity="0.38" />
            <stop offset="68%" stop-color="#ffffff" stop-opacity="0.62" />
            <stop offset="100%" stop-color="#a3a3a3" stop-opacity="0" />
          </linearGradient>
        </defs>

        {breezeRibbons.map((ribbon) => (
          <path
            d={ribbon.d}
            pathLength="1000"
            class="ygg-breeze-ribbon"
            stroke="url(#ygg-section-wind-grad)"
            stroke-width="1.5"
            stroke-linecap="round"
            fill="none"
            style={`--wisp-opacity: ${ribbon.opacity}; animation-delay: ${ribbon.delay}; animation-duration: ${ribbon.duration};`}
          />
        ))}

        {driftingLeaves.map((leaf) => (
          <g
            class="ygg-drifting-leaf"
            style={`--leaf-y: ${leaf.y}px; --leaf-scale: ${leaf.scale}; animation-delay: ${leaf.delay}; animation-duration: ${leaf.duration};`}
          >
            <path
              d="M-6,0 C0,-6 10,-3 7,5 C1,7 -5,4 -6,0 Z"
              fill="#262626"
              stroke="#a3a3a3"
              stroke-width="0.9"
            />
          </g>
        ))}

        {flyingBirds.map((bird) => (
          <g
            class="ygg-bird-flight"
            style={`--bird-y: ${bird.y}px; --bird-scale: ${bird.scale}; animation-delay: ${bird.delay}; animation-duration: ${bird.duration};`}
          >
            <g class="ygg-bird-body">
              <path d="M-4,0 Q0,-2 6,-0.5 Q2,1.5 -4,0 Z" fill="#d4d4d4" />
              <g class="ygg-bird-wing" style={`animation-duration: ${bird.flapDur};`}>
                <path d="M-1,-0.5 Q3,-9 9,-6 Q4,-2 1,-0.5 Z" fill="#e5e5e5" />
                <path d="M-2,-0.5 Q-6,-7 -10,-4 Q-6,-1 -1,-0.5 Z" fill="#a3a3a3" />
              </g>
            </g>
          </g>
        ))}
      </svg>
    </div>

    <!-- Centered Section Title -->
    <div class="text-center mx-auto max-w-2xl mb-4 reveal velocity-skew">
      <p class="text-xs font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-2">My Journey</p>
      <h2 class="text-4xl lg:text-5xl font-black text-[#e5e5e5]">
        Experience <span class="text-[#a3a3a3]">&amp;</span> Education
      </h2>
    </div>

    <!-- DESKTOP STAGE: Compact Iconic Yggdrasil World Tree (matching reference proportion) -->
    <div class="hidden md:block relative max-w-[980px] mx-auto reveal">
      <div class="relative w-full aspect-[25/18] select-none overflow-visible">
        <!-- Real-Time Orbital Sun (05:30 - 18:00, Monochrome Theme) -->
        <div
          id="ygg-celestial-sun"
          class="pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 z-0 opacity-0 transition-opacity duration-1000"
          style="left: 50%; top: 10%;"
          aria-hidden="true"
        >
          <div id="ygg-sun-aura" class="relative w-16 h-16 lg:w-20 lg:h-20 flex items-center justify-center">
            <span class="pointer-events-none absolute -inset-1.5 rounded-full border border-[#a3a3a3]/25"></span>
            <span class="ygg-sun-rays absolute inset-0 rounded-full border border-dashed border-[#e5e5e5]/50"></span>
            <span class="ygg-sun-core w-9 h-9 lg:w-11 lg:h-11 rounded-full border border-[#ffffff] bg-gradient-to-br from-[#ffffff] via-[#f5f5f5] to-[#d4d4d4] shadow-[0_0_38px_rgba(255,255,255,0.5)]"></span>
          </div>
        </div>

        <!-- Real-Time Orbital Moon (18:00 - 05:30, Monochrome Theme) -->
        <div
          id="ygg-celestial-moon"
          class="pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 z-0 opacity-0 transition-opacity duration-1000"
          style="left: 50%; top: 10%;"
          aria-hidden="true"
        >
          <div class="relative w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center">
            <span class="absolute -inset-2 rounded-full bg-[#e5e5e5]/10 blur-md"></span>
            <div class="relative w-9 h-9 lg:w-11 lg:h-11 rounded-full border border-[#a3a3a3]/55 bg-gradient-to-br from-[#e5e5e5] via-[#a3a3a3] to-[#262626] shadow-[0_0_30px_rgba(229,229,229,0.22)] overflow-hidden">
              <span class="absolute top-2 left-2 w-2 h-2 rounded-full bg-[#171717]/40"></span>
              <span class="absolute bottom-2.5 right-2 w-2.5 h-2.5 rounded-full bg-[#171717]/45"></span>
              <span class="absolute top-5 right-3 w-1.5 h-1.5 rounded-full bg-[#262626]/35"></span>
            </div>
          </div>
        </div>

        <!-- SVG World Tree Illustration -->
        <svg
          class="relative z-10 w-full h-full pointer-events-none"
          viewBox="0 0 1000 720"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <!-- Ambient cosmic halo behind crown & trunk (contained safely inside ellipse to avoid edge clipping) -->
            <radialGradient id="ygg-cosmos" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.09" />
              <stop offset="55%" stop-color="#737373" stop-opacity="0.03" />
              <stop offset="100%" stop-color="#0a0a0a" stop-opacity="0" />
            </radialGradient>

            <!-- Trunk sculpted obsidian bark gradient -->
            <linearGradient id="ygg-trunk" x1="360" y1="220" x2="640" y2="620" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#2b2b2b" />
              <stop offset="38%" stop-color="#191919" />
              <stop offset="72%" stop-color="#121212" />
              <stop offset="100%" stop-color="#1f1f1f" />
            </linearGradient>

            <!-- Silver-lit bark ridge accent -->
            <linearGradient id="ygg-sap" x1="500" y1="180" x2="500" y2="670" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.65" />
              <stop offset="50%" stop-color="#a3a3a3" stop-opacity="0.45" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0.22" />
            </linearGradient>

            <!-- Foliage crown gradients (obsidian to moonlight silver rim) -->
            <linearGradient id="ygg-canopy-back" x1="500" y1="30" x2="500" y2="265" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#262626" />
              <stop offset="65%" stop-color="#151515" />
              <stop offset="100%" stop-color="#0c0c0c" />
            </linearGradient>
            <linearGradient id="ygg-canopy-mid" x1="500" y1="40" x2="500" y2="245" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#3f3f3f" />
              <stop offset="55%" stop-color="#202020" />
              <stop offset="100%" stop-color="#111111" />
            </linearGradient>
            <linearGradient id="ygg-canopy-rim" x1="500" y1="32" x2="500" y2="195" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f5f5f5" stop-opacity="0.88" />
              <stop offset="45%" stop-color="#a3a3a3" stop-opacity="0.42" />
              <stop offset="100%" stop-color="#262626" stop-opacity="0.08" />
            </linearGradient>

            <!-- Wind gust stream gradient -->
            <linearGradient id="ygg-wind-grad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#a3a3a3" stop-opacity="0" />
              <stop offset="35%" stop-color="#e5e5e5" stop-opacity="0.38" />
              <stop offset="68%" stop-color="#ffffff" stop-opacity="0.58" />
              <stop offset="100%" stop-color="#a3a3a3" stop-opacity="0" />
            </linearGradient>

            <!-- Soft glow for conduits -->
            <filter id="ygg-soft-glow" x="-25%" y="-25%" width="150%" height="150%">
              <feGaussianBlur stdDeviation="3.5" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Atmospheric Radial Cosmic Nebula (fades completely before SVG left/right edges) -->
          <ellipse cx="500" cy="350" rx="430" ry="300" fill="url(#ygg-cosmos)" />

          <!-- Subtle Geometric Runic Halo behind Yggdrasil Heart -->
          <g opacity="0.18" stroke="#525252" stroke-width="1">
            <circle cx="500" cy="395" r="235" stroke-dasharray="4 8" />
            <circle cx="500" cy="395" r="180" stroke-dasharray="14 6" />
            <circle cx="500" cy="395" r="295" stroke-opacity="0.45" />
