// Deterministic PRNG for build-time Yggdrasil sub-branches & fine twigs
function createRng(seed: number) {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
}

interface TwigSegment {
  d: string;
  stroke: string;
  width: number;
  opacity: number;
}

const rng = createRng(20261122);
const canopyTwigs: TwigSegment[] = [];

function growBranch(x: number, y: number, angleDeg: number, length: number, depth: number) {
  const rad = (angleDeg * Math.PI) / 180;
  const x2 = x + Math.cos(rad) * length;
  const y2 = y + Math.sin(rad) * length;

  // Natural gentle upward/outward curvature
  const midX = (x + x2) / 2 + (rng() - 0.5) * 14;
  const midY = (y + y2) / 2 - 4 + (rng() - 0.5) * 8;

  canopyTwigs.push({
    d: `M ${x.toFixed(1)} ${y.toFixed(1)} Q ${midX.toFixed(1)} ${midY.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    stroke: depth === 3 ? '#71717a' : depth === 2 ? '#52525b' : '#3f3f46',
    width: depth === 3 ? 1.7 : depth === 2 ? 1.25 : 0.9,
    opacity: depth === 3 ? 0.92 : depth === 2 ? 0.85 : 0.78,
  });

  if (depth <= 1) return;

  const spread = 24 + rng() * 14;
  const shrink = 0.68 + rng() * 0.1;
  growBranch(x2, y2, angleDeg - spread + (rng() - 0.5) * 8, length * shrink, depth - 1);
  growBranch(x2, y2, angleDeg + spread + (rng() - 0.5) * 8, length * shrink, depth - 1);
}

// Anchors positioned directly along left/center/right sculpted canopy boughs (mirroring left -> right around x=500)
const leftCanopySeeds: Array<{ x: number; y: number; angle: number; len: number }> = [
  // Outer sweeping left main bough
  { x: 404, y: 224, angle: -138, len: 36 },
  { x: 332, y: 192, angle: -134, len: 38 },
  { x: 266, y: 174, angle: -146, len: 36 },
  { x: 198, y: 162, angle: -162, len: 35 },
  { x: 132, y: 152, angle: -168, len: 32 },
  // Mid-left ascending crown bough
  { x: 428, y: 204, angle: -116, len: 34 },
  { x: 362, y: 146, angle: -126, len: 38 },
  { x: 294, y: 112, angle: -138, len: 36 },
  { x: 230, y: 92, angle: -150, len: 35 },
  { x: 174, y: 84, angle: -162, len: 32 },
  // Upper-left crown fork
  { x: 458, y: 148, angle: -108, len: 36 },
  { x: 412, y: 94, angle: -118, len: 35 },
  { x: 356, y: 64, angle: -132, len: 32 },
  { x: 476, y: 102, angle: -100, len: 32 },
];

for (const seed of leftCanopySeeds) {
  growBranch(seed.x, seed.y, seed.angle, seed.len, 2);
  const rx = 1000 - seed.x;
  const rAngle = -180 - seed.angle;
  growBranch(rx, seed.y, rAngle, seed.len, 2);
}

// Central apex crown twigs
growBranch(500, 62, -90, 34, 2);
growBranch(492, 120, -104, 30, 2);
growBranch(508, 120, -76, 30, 2);

// Small organic side-twigs + leaf clusters sprouting along the vertical trunk (viewBox width 56, trunk edges x=6..50)
const trunkSprouts = [
  { side: 'left', y: 64 },
