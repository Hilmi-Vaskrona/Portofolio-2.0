---
const timeline = [
  {
    code: 'EXP-01',
    year: '2024 - Sekarang',
    title: 'SMK Madinatul Quran',
    subtitle: 'Jurusan Rekayasa Perangkat Lunak (RPL)',
    description: 'Sedang menempuh pendidikan dan mempelajari pengembangan perangkat lunak, UI/UX design, dan web development.',
    icon: `<svg class="w-5 h-5 text-[#e5e5e5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>`,
  },
  {
    code: 'EXP-02',
    year: '2024',
    title: 'Project: Landing Page Bali.Tour',
    subtitle: 'Web Development',
    description: 'Membangun landing page pariwisata Bali dengan HTML, CSS, dan JavaScript.',
    icon: `<svg class="w-5 h-5 text-[#e5e5e5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  },
  {
    code: 'EXP-03',
    year: '2025',
    title: 'Project: The Parfume & Sabun Kallos',
    subtitle: 'Web Development & Design',
    description: 'Mengembangkan situs web e-commerce untuk produk parfum dan sabun.',
    icon: `<svg class="w-5 h-5 text-[#e5e5e5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
  },
  {
    code: 'EXP-04',
    year: '2025',
    title: 'Project: SMK MQ Landing Page',
    subtitle: 'UI/UX Design',
    description: 'Merancang desain landing page untuk SMK Madinatul Quran.',
    icon: `<svg class="w-5 h-5 text-[#e5e5e5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>`,
  },
  {
    code: 'EXP-05',
    year: '2025',
    title: 'Nostalgic Game Retro',
    subtitle: 'E-commerce Design',
    description: 'Mendesain platform e-commerce untuk game retro dan nostalgia.',
    icon: `<svg class="w-5 h-5 text-[#e5e5e5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.25 8h-10.5a5.75 5.75 0 00-5.682 6.822 1.5 1.5 0 002.936.43.75.75 0 011.157-.307h13.678a.75.75 0 011.157.307 1.5 1.5 0 002.936-.43A5.75 5.75 0 0017.25 8zM5.625 10.5h.01M6.75 10.5v1.125M7.875 11.25h-1.125M18.75 11.25h.01M17.625 12.375h.01" /></svg>`,
  },
];
---

<section id="experience" class="relative overflow-hidden">
  <!-- Chanhdai Section Header Bar -->
  <div class="border-b border-[#262626] px-6 py-3 flex items-center justify-between text-xs font-mono text-[#525252] bg-[#0a0a0a]">
    <span>SEC // 03 &mdash; TIMELINE</span>
    <span>[ EXPERIENCE.LOG ]</span>
  </div>

  <!-- JackieZhang Kinetic Scroll Marquee Background -->
  <div class="pointer-events-none select-none overflow-hidden py-4 border-b border-[#262626]/60 bg-[#0d0d0d]">
    <div class="scroll-marquee-track whitespace-nowrap font-display text-3xl sm:text-5xl font-black tracking-widest text-[#1a1a1a] uppercase" data-marquee-speed="-0.16">
      <span>EXPERIENCE &amp; EDUCATION &bull; MILESTONES &bull; JOURNEY &bull; </span>
      <span>EXPERIENCE &amp; EDUCATION &bull; MILESTONES &bull; JOURNEY &bull; </span>
    </div>
  </div>

  <div class="p-6 lg:p-12 relative">
    <span class="corner-plus -top-[5px] -left-[5px]"></span>
    <span class="corner-plus -top-[5px] -right-[5px]"></span>

    <div class="mb-10 reveal velocity-skew">
      <p class="text-xs font-mono text-[#a3a3a3] tracking-[0.3em] uppercase mb-2">My Journey</p>
      <h2 class="text-4xl lg:text-5xl font-black text-[#e5e5e5]">Experience <span class="text-[#a3a3a3]">&amp;</span> Education</h2>
    </div>

    <!-- Chanhdai Structured Log Table / Timeline -->
    <div class="border border-[#262626] rounded-2xl overflow-hidden divide-y divide-[#262626] bg-[#111111]/40">
      {timeline.map((item, i) => (
        <div
          class="spotlight-card group relative grid grid-cols-1 lg:grid-cols-12 p-6 lg:p-8 hover:bg-[#151515]/80 transition-colors duration-300 reveal velocity-skew"
          style={`--reveal-delay: ${i * 75}ms;`}
        >
          <!-- Left Meta Column -->
          <div class="lg:col-span-4 flex items-start gap-4 mb-4 lg:mb-0">
            <div
              class="w-11 h-11 rounded-xl bg-[#0a0a0a] border border-[#262626] group-hover:border-[#a3a3a3] flex items-center justify-center shrink-0 transition-all duration-300 shadow-[0_0_20px_#a3a3a315]"
              set:html={item.icon}
            />
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#0a0a0a] border border-[#262626] text-[#a3a3a3]">{item.code}</span>
                <span class="text-xs font-mono text-[#a3a3a3]">{item.year}</span>
              </div>
              <p class="text-xs font-mono text-[#525252] mt-1.5 uppercase tracking-wider">{item.subtitle}</p>
            </div>
          </div>

          <!-- Right Details Column -->
          <div class="lg:col-span-8 lg:pl-6 lg:border-l border-[#262626]/60 flex flex-col justify-center">
            <h3 class="text-lg lg:text-xl font-bold text-[#e5e5e5] group-hover:text-white transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-[#a3a3a3] mt-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
