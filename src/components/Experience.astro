  <!-- Scoped Client Script for Active Realm Inspection -->
  <script define:vars={{ realmsData: timeline }}>
    const section = document.getElementById('experience');
    if (section) {
      const nodes = Array.from(section.querySelectorAll('.ygg-realm-node'));
      const pills = Array.from(section.querySelectorAll('.ygg-step-pill'));
      const triggers = Array.from(section.querySelectorAll('[data-realm-trigger]'));

      const detailIcon = document.getElementById('ygg-detail-icon');
      const detailCode = document.getElementById('ygg-detail-code');
      const detailYear = document.getElementById('ygg-detail-year');
      const detailRealm = document.getElementById('ygg-detail-realm');
      const detailTitle = document.getElementById('ygg-detail-title');
      const detailSubtitle = document.getElementById('ygg-detail-subtitle');
      const detailDesc = document.getElementById('ygg-detail-desc');

      function setActiveRealm(index) {
        const item = realmsData[index];
        if (!item) return;

        nodes.forEach((node, idx) => {
          node.classList.toggle('is-active', idx === index);
        });

        pills.forEach((pill, idx) => {
          const active = idx === index;
          pill.classList.toggle('is-active', active);
          pill.classList.toggle('border-[#e5e5e5]', active);
          pill.classList.toggle('bg-[#e5e5e5]', active);
          pill.classList.toggle('text-[#0a0a0a]', active);
          pill.classList.toggle('font-bold', active);
          pill.classList.toggle('border-[#262626]', !active);
          pill.classList.toggle('bg-[#0d0d0d]', !active);
          pill.classList.toggle('text-[#737373]', !active);
        });

        if (detailIcon) detailIcon.innerHTML = item.icon;
        if (detailCode) detailCode.textContent = item.code;
        if (detailYear) detailYear.textContent = item.year;
        if (detailRealm) detailRealm.textContent = item.realm;
        if (detailTitle) detailTitle.textContent = item.title;
        if (detailSubtitle) detailSubtitle.textContent = item.subtitle;
        if (detailDesc) detailDesc.textContent = item.description;
      }

      triggers.forEach((btn) => {
        const idx = Number(btn.getAttribute('data-realm-trigger'));
        btn.addEventListener('mouseenter', () => setActiveRealm(idx));
        btn.addEventListener('focus', () => setActiveRealm(idx));
        btn.addEventListener('click', () => setActiveRealm(idx));
      });
    }
  </script>

  <!-- Scoped Real-Time Sun/Moon Sky Cycle Controller for Yggdrasil -->
  <script>
    import { subscribeSkyCycle, getOrbitalPercent } from '../lib/skyCycle';

    const yggSkyAtmos = document.getElementById('ygg-sky-atmosphere');
    const yggSunEl = document.getElementById('ygg-celestial-sun');
    const yggMoonEl = document.getElementById('ygg-celestial-moon');
    const yggStarsEl = document.getElementById('ygg-stars-group');
    const yggBadgeEl = document.getElementById('ygg-sky-badge');

    subscribeSkyCycle((state) => {
      if (yggStarsEl) {
        yggStarsEl.setAttribute('opacity', state.starOpacity.toFixed(2));
      }
      if (yggBadgeEl) {
        const iconChar = state.isDay ? '☀' : '☾';
        yggBadgeEl.textContent = `[ ${iconChar} ${state.timeLabel} // ${state.phaseLabel} ]`;
      }

      const arc = getOrbitalPercent(state.progress, 10, 90, 8, 44);
      if (yggSkyAtmos) {
        const glowX = (50 + (arc.xPercent - 50) * 0.66).toFixed(1);
        const glowY = (arc.yPercent + 10).toFixed(1);
        const glowAlpha = state.isDay ? '0.13' : '0.09';
        yggSkyAtmos.style.background = `radial-gradient(circle 360px at ${glowX}% ${glowY}%, rgba(229, 229, 229, ${glowAlpha}) 0%, rgba(10, 10, 10, 0) 100%)`;
      }
      if (yggSunEl) {
        yggSunEl.style.left = `${arc.xPercent.toFixed(2)}%`;
        yggSunEl.style.top = `${arc.yPercent.toFixed(2)}%`;
        yggSunEl.style.opacity = state.isDay ? '1' : '0';
        const sunCore = yggSunEl.querySelector('.ygg-sun-core') as HTMLElement | null;
        if (sunCore) {
          if (state.sunWarmth > 0.6) {
            sunCore.style.boxShadow = '0 0 36px rgba(212, 212, 212, 0.42), 0 0 16px rgba(229, 229, 229, 0.55)';
          } else {
            sunCore.style.boxShadow = '0 0 44px rgba(255, 255, 255, 0.6), 0 0 20px rgba(255, 255, 255, 0.75)';
          }
        }
      }

      if (yggMoonEl) {
        yggMoonEl.style.left = `${arc.xPercent.toFixed(2)}%`;
        yggMoonEl.style.top = `${arc.yPercent.toFixed(2)}%`;
        yggMoonEl.style.opacity = state.isDay ? '0' : '1';
      }
    });
  </script>
</section>

