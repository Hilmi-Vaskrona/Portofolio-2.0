---
interface Collaborator {
  username: string;
  name: string;
  avatar: string;
  profileUrl: string;
  role: string;
  commits?: number;
}

interface CollabProject {
  code: string;
  year: string;
  repoName: string;
  repoFullName: string;
  repoUrl: string;
  title: string;
  scope: string;
  description: string;
  tech: string[];
  featured?: boolean;
  collaborators: Collaborator[];
}

const collabProjects: CollabProject[] = [
  {
    code: 'CLB-01',
    year: '2026',
    repoName: 'vokasi_lp',
    repoFullName: 'Hilmi-Vaskrona/vokasi_lp',
    repoUrl: 'https://github.com/Hilmi-Vaskrona/vokasi_lp',
    title: 'Vokasi Landing Page & Web Portal',
    scope: 'Team Collaboration • 5 Contributors',
    description:
      'Kolaborasi tim membangun portal dan landing page interaktif berbasis React & TypeScript dengan animasi transisi modern, editor konten kaya (CKEditor), serta manajemen data asinkron menggunakan TanStack Query.',
    tech: ['React', 'TypeScript', 'Tailwind CSS', 'GSAP', 'Framer Motion', 'TanStack Query'],
    featured: true,
    collaborators: [
      {
        username: 'Krunia101',
        name: 'Karunia Ibrahim',
        avatar: 'https://avatars.githubusercontent.com/u/149747893?v=4',
        profileUrl: 'https://github.com/Krunia101',
        role: 'Collaborator',
        commits: 37,
      },
      {
        username: 'sicoding1120',
        name: 'Daffa Hafizh Firdaus',
        avatar: 'https://avatars.githubusercontent.com/u/147905588?v=4',
        profileUrl: 'https://github.com/sicoding1120',
        role: 'Collaborator',
        commits: 24,
      },
      {
        username: 'ahfary',
        name: 'Ahfary',
        avatar: 'https://avatars.githubusercontent.com/u/145752722?v=4',
        profileUrl: 'https://github.com/ahfary',
        role: 'Collaborator',
        commits: 7,
      },
      {
        username: 'mhardiansyah',
        name: 'M. Hardiansyah',
        avatar: 'https://avatars.githubusercontent.com/u/149748253?v=4',
        profileUrl: 'https://github.com/mhardiansyah',
        role: 'Collaborator',
        commits: 3,
      },
    ],
  },
  {
    code: 'CLB-02',
    year: '2026',
    repoName: 'Frontend-Nusafone',
    repoFullName: 'Hilmi-Vaskrona/Frontend-Nusafone',
    repoUrl: 'https://github.com/Hilmi-Vaskrona/Frontend-Nusafone',
    title: 'Nusafone Frontend Web Platform',
    scope: 'Pair Collaboration • Frontend',
    description:
      'Pengembangan bersama antarmuka aplikasi web Nusafone menggunakan Next.js dan TypeScript, dilengkapi validasi form terstruktur (Zod + React Hook Form) serta state management ringan berbasis Zustand.',
    tech: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Zustand', 'Zod'],
    collaborators: [
      {
        username: 'Hamzahzahh09',
        name: 'Hamzah Ahmad',
        avatar: 'https://avatars.githubusercontent.com/u/186898142?v=4',
        profileUrl: 'https://github.com/Hamzahzahh09',
        role: 'Frontend Collaborator',
        commits: 2,
      },
    ],
  },
  {
    code: 'CLB-03',
    year: '2025',
    repoName: 'UAS-Collaborate',
    repoFullName: 'Hilmi-Vaskrona/UAS-Collaborate',
    repoUrl: 'https://github.com/Hilmi-Vaskrona/UAS-Collaborate',
    title: 'Travel Project Collaboration',
    scope: 'Pair Collaboration • Web App',
    description:
      'Proyek kolaborasi UAS membangun aplikasi web bertema travel & destinasi wisata yang responsif, cepat, dan interaktif menggunakan ekosistem Vue 3, Vue Router, Swiper, dan Tailwind CSS.',
    tech: ['Vue 3', 'Vite', 'Vue Router', 'Tailwind CSS', 'Swiper'],
    collaborators: [
      {
        username: 'fadlanmawardi',
