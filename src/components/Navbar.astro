---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Portfolio', href: '#portfolio' },
  { label: 'Sertifikat', href: '#sertifikat' },
  { label: 'Contact', href: '#contact' },
];
---

<header id="navbar-wrapper">
  <div id="navbar-shell" aria-label="Main Navigation">
    <div id="navbar-orb-ring"></div>

    <!-- Brand / Orb Centerpiece -->
    <a
      id="nav-brand-link"
      href="#home"
      class="flex items-center gap-2.5 text-xl font-black font-display tracking-tight shrink-0 group relative z-10"
      aria-label="Hilmi Home"
    >
      <div class="relative flex items-center justify-center w-9 h-9 rounded-full bg-[#111111] border border-[#262626] group-hover:border-[#a3a3a3]/60 transition-colors duration-300">
        <img src="/logo_vaskrona.png" alt="Hilmi Logo" class="w-6 h-6 object-contain logo-glow transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110" />
      </div>
      <div class="nav-brand-text flex items-center whitespace-nowrap">
        <span class="text-[#e5e5e5]">Hilmi</span><span class="text-[#a3a3a3]">.</span>
      </div>
    </a>

    <!-- Desktop Links with Metalab Slot-Roll Hover & Magnetic Pill -->
    <nav id="nav-links-container" class="hidden md:flex items-center gap-1 relative py-1 px-1.5 rounded-full bg-[#111111]/70 border border-[#262626]/80">
      <div id="nav-hover-pill"></div>
      {navLinks.map((link, idx) => (
        <a
          href={link.href}
          class="metalab-nav-item whitespace-nowrap"
          style={`--item-index: ${idx};`}
        >
          <span class="metalab-text-wrap">
            <span class="metalab-text-primary">{link.label}</span>
            <span class="metalab-text-clone" aria-hidden="true">{link.label}</span>
          </span>
        </a>
      ))}
    </nav>

    <!-- Status Indicator (Chanhdai style) -->
    <div id="nav-status-badge" class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-full border border-[#262626] bg-[#111111]/80 text-xs font-mono text-[#a3a3a3] whitespace-nowrap shrink-0">
      <span class="w-2 h-2 rounded-full bg-[#e5e5e5] animate-pulse shadow-[0_0_8px_#e5e5e5]"></span>
      <span>AVAILABLE</span>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-[#a3a3a3] hover:text-[#e5e5e5] p-2 cursor-pointer relative z-10"
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <nav
    id="mobile-menu"
    class="hidden fixed top-20 left-4 right-4 flex-col items-center gap-4 py-6 px-6 bg-[#0a0a0a]/95 rounded-2xl border border-[#262626] backdrop-blur-2xl shadow-2xl pointer-events-auto z-50"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="w-full text-center py-2.5 text-base font-mono uppercase tracking-widest text-[#a3a3a3] hover:text-[#e5e5e5] border-b border-[#262626]/40 last:border-none transition-colors duration-300"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const navWrapper = document.getElementById('navbar-wrapper');
  const navShell = document.getElementById('navbar-shell');
  const navLinksContainer = document.getElementById('nav-links-container');
  const hoverPill = document.getElementById('nav-hover-pill');
  const navItems = document.querySelectorAll('.metalab-nav-item');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const brandLink = document.getElementById('nav-brand-link');

  let collapseTimer: ReturnType<typeof setTimeout> | null = null;

  // Update scrolled state: sticky bar at top -> morphing floating circle on scroll
  function handleNavScroll() {
    if (!navWrapper) return;
    if (window.scrollY > 80) {
      navWrapper.classList.add('is-scrolled');
    } else {
      navWrapper.classList.remove('is-scrolled', 'is-expanded');
    }
  }

  window.addEventListener('scroll', handleNavScroll, { passive: true });
  handleNavScroll();

  // Expand circle when cursor hovers over it
  navShell?.addEventListener('mouseenter', () => {
    if (collapseTimer) clearTimeout(collapseTimer);
    if (navWrapper?.classList.contains('is-scrolled')) {
      navWrapper.classList.add('is-expanded');
    }
  });

  navShell?.addEventListener('mouseleave', () => {
    if (navWrapper?.classList.contains('is-scrolled')) {
      collapseTimer = setTimeout(() => {
        navWrapper.classList.remove('is-expanded');
        if (hoverPill) hoverPill.style.opacity = '0';
      }, 180);
    }
  });

  // On touch devices, tapping the orb when collapsed expands it or opens mobile menu
  brandLink?.addEventListener('click', (e) => {
    if (
      navWrapper?.classList.contains('is-scrolled') &&
      !navWrapper.classList.contains('is-expanded')
    ) {
      e.preventDefault();
      if (window.innerWidth < 768) {
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
      } else {
        navWrapper.classList.add('is-expanded');
      }
    }
  });

  // Metalab Magnetic Pill Hover Tracking
  navItems.forEach((item) => {
    item.addEventListener('mouseenter', () => {
      if (!hoverPill || !navLinksContainer) return;
      const itemRect = (item as HTMLElement).getBoundingClientRect();
      const containerRect = navLinksContainer.getBoundingClientRect();
      const offsetX = itemRect.left - containerRect.left;

      hoverPill.style.setProperty('--pill-x', `${offsetX}px`);
      hoverPill.style.setProperty('--pill-w', `${itemRect.width}px`);
      hoverPill.style.opacity = '1';
    });
  });

  navLinksContainer?.addEventListener('mouseleave', () => {
    if (hoverPill) {
      hoverPill.style.opacity = '0';
    }
  });

  // Mobile Menu Toggle
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
    });
  });
</script>
