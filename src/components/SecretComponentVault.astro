        <span class="text-[#d4d4d8] font-semibold">SEC // 03 &mdash; VASKRONA COMPONENT REGISTRY</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 rounded border border-[#262626] bg-[#111115] text-[10px] text-[#e5e5e5]">
          REWARD UNLOCKED &bull; {vaultItems.length} COMPONENTS
        </span>
        <span class="hidden sm:inline text-[#525252]">[ INSPIRED BY CHANHDAI.COM ]</span>
      </div>
    </div>

    <!-- Registry Intro & Reward Banner -->
    <div class="p-6 sm:p-8 lg:p-10 border-b border-[#262626] dot-matrix-bg relative overflow-hidden">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded border border-[#2f2f35] bg-[#111114] text-[11px] font-mono text-[#d4d4d8] mb-4">
          <span>EXPLORER PRIVILEGE // OPEN SOURCE VAULT</span>
