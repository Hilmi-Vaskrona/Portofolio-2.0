            class="shrink-0 inline-flex items-center gap-1.5 rounded-md border border-[#3f3f46] bg-[#141418] px-3 py-1.5 font-mono text-xs text-[#e5e5e5] hover:border-[#e5e5e5] hover:bg-[#1c1c22] transition-colors cursor-pointer"
          >
