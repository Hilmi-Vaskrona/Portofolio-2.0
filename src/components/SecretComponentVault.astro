        <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5">
          <div class="relative flex-1 sm:w-64">
            <input
              id="vault-search-input"
              type="text"
              autocomplete="off"
              placeholder="Cari komponen (pixel, hero, city...)"
              class="w-full rounded-md border border-[#262626] bg-[#0b0b0e] pl-3 pr-8 py-1.5 font-mono text-xs text-[#e5e5e5] placeholder-[#525252] focus:border-[#a3a3a3] focus:outline-none"
            />
            <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 font-mono text-[10px] text-[#525252]">
              /
            </span>
          </div>

          <button
