                      <span class="text-[#e5e5e5]">SWE &amp; UI/UX</span>
                    </div>
                  </div>
                )}

                {item.previewType === 'timeline-log' && (
                  <div class="w-52 rounded-lg border border-[#2a2a32] bg-[#101014] divide-y divide-[#232329] font-mono text-[9px]">
                    <div class="px-2.5 py-1.5 flex items-center justify-between">
                      <span class="text-[#e5e5e5] font-bold">EXP-01</span>
                      <span class="text-[#71717a]">SMK MQ &bull; RPL</span>
                    </div>
                    <div class="px-2.5 py-1.5 flex items-center justify-between">
                      <span class="text-[#a1a1aa]">EXP-02</span>
                      <span class="text-[#71717a]">Bali.Tour Web</span>
                    </div>
                    <div class="px-2.5 py-1.5 flex items-center justify-between">
                      <span class="text-[#a1a1aa]">EXP-03</span>
                      <span class="text-[#71717a]">The Parfume</span>
                    </div>
                  </div>
                )}

                {item.previewType === 'collab-network' && (
                  <div class="w-52 p-2.5 rounded-lg border border-[#2a2a32] bg-[#101014] space-y-2 font-mono text-[9px]">
                    <div class="flex items-center justify-between text-[#d4d4d8]">
                      <span class="px-1.5 py-0.5 rounded bg-[#18181f] border border-[#2e2e38]">CLB-01</span>
                      <span class="text-[#71717a]">vokasi_lp</span>
                    </div>
                    <div class="flex items-center justify-between pt-1 border-t border-[#22222a]">
                      <div class="flex -space-x-1.5">
                        {['HK', 'KR', 'SC', 'AH'].map((init) => (
                          <span class="w-5 h-5 rounded-full bg-[#1f1f27] border border-[#3f3f46] flex items-center justify-center text-[7px] text-[#e5e5e5]">
                            {init}
                          </span>
                        ))}
                      </div>
                      <span class="text-[#a1a1aa]">8 Peers &nearr;</span>
                    </div>
                  </div>
                )}

                {item.previewType === 'project-grid' && (
                  <div class="w-48 space-y-1.5 font-mono text-[9px]">
                    <div class="flex gap-1">
                      <span class="px-1.5 py-0.5 rounded bg-[#e5e5e5] text-[#0a0a0a] font-bold">All</span>
                      <span class="px-1.5 py-0.5 rounded border border-[#27272a] text-[#71717a]">Web</span>
                      <span class="px-1.5 py-0.5 rounded border border-[#27272a] text-[#71717a]">UI/UX</span>
                    </div>
                    <div class="grid grid-cols-2 gap-1.5">
                      <div class="p-2 rounded border border-[#2a2a32] bg-[#121217] text-[#d4d4d8]">PRJ-01</div>
                      <div class="p-2 rounded border border-[#2a2a32] bg-[#121217] text-[#d4d4d8]">PRJ-02</div>
                    </div>
                  </div>
                )}

                {item.previewType === 'cert-vault' && (
                  <div class="grid grid-cols-3 gap-1.5 w-48">
                    {[1, 2, 3].map((n) => (
                      <div class="h-14 rounded border border-[#2e2e36] bg-[#121217] p-1.5 flex flex-col justify-between font-mono text-[8px]">
                        <span class="w-4 h-1 bg-[#52525b] rounded"></span>
                        <span class="text-[#d4d4d8]">CRT-0{n}</span>
                      </div>
                    ))}
                  </div>
                )}

                {item.previewType === 'testimonials' && (
                  <div class="w-48 p-2.5 rounded-lg border border-[#2a2a32] bg-[#111116] text-left">
                    <div class="text-sm font-serif text-[#71717a] leading-none">"</div>
                    <p class="text-[9px] text-[#a1a1aa] italic line-clamp-2">
                      Sentuhan kreatif yang berbeda di setiap project...
                    </p>
                    <div class="mt-1.5 pt-1 border-t border-[#222228] font-mono text-[8px] text-[#e5e5e5]">
                      &mdash; Mentor &amp; Guru RPL
                    </div>
                  </div>
                )}

                {item.previewType === 'contact-form' && (
                  <div class="w-48 p-2.5 rounded-lg border border-[#2a2a32] bg-[#101014] space-y-1.5 font-mono text-[8px]">
                    <div class="px-2 py-1 rounded border border-[#262626] bg-[#0a0a0c] text-[#71717a]">
                      you@example.com
                    </div>
                    <div class="px-2 py-1 rounded bg-[#e5e5e5] text-[#0a0a0a] font-bold text-center">
                      SEND TRANSMISSION &rarr;
                    </div>
                  </div>
                )}

                {item.previewType === 'grid-css' && (
                  <div class="w-48 border border-[#3f3f46] bg-[#0b0b0f] p-3 relative font-mono text-[9px] text-[#d4d4d8]">
                    <span class="corner-plus -top-[5px] -left-[5px]"></span>
                    <span class="corner-plus -top-[5px] -right-[5px]"></span>
                    <span class="corner-plus -bottom-[5px] -left-[5px]"></span>
                    <span class="corner-plus -bottom-[5px] -right-[5px]"></span>
                    <div class="hatch-divider !h-3 mb-2"></div>
                    <div class="text-center text-[10px] text-[#e5e5e5]">.spotlight-card + .hatch</div>
                  </div>
                )}

                <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-[#0a0a0d]/90 border border-[#27272a] font-mono text-[9px] text-[#a1a1aa] opacity-0 group-hover:opacity-100 transition-opacity">
                  Inspect Code &nearr;
                </span>
              </div>

              <!-- Component Title & Description -->
              <h3 class="text-base font-bold text-[#f4f4f5] group-hover:text-[#ffffff] leading-snug">
                {item.name}
              </h3>
              <p class="mt-1.5 text-xs text-[#a1a1aa] leading-relaxed line-clamp-3 font-sans">
                {item.description}
              </p>
            </div>

            <!-- Footer Metadata + Quick Actions -->
            <div class="mt-4 pt-3.5 border-t border-[#1c1c22] space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-1 font-mono text-[10px] text-[#71717a]">
                <span class="truncate text-[#a1a1aa]">{primaryFile.filename}{item.files.length > 1 ? ` +${item.files.length - 1}` : ''}</span>
                <span class="tabular-nums">{totalLines}L &bull; {primaryFile.sizeKb}</span>
              </div>

              <div class="flex items-center gap-1.5 font-mono text-[11px]">
                <button
                  type="button"
                  data-open-vault-index={index}
                  class="flex-1 rounded border border-[#3f3f46] bg-[#16161c] px-2.5 py-1.5 text-[#ffffff] font-semibold hover:border-[#e5e5e5] hover:bg-[#22222a] transition-colors cursor-pointer"
                >
                  View Code
                </button>
                <button
                  type="button"
                  data-copy-vault-index={index}
                  class="rounded border border-[#27272a] bg-[#101014] px-2.5 py-1.5 text-[#d4d4d8] hover:border-[#e5e5e5] hover:text-[#ffffff] transition-colors cursor-pointer"
                  title={`Copy ${primaryFile.filename}`}
                >
                  Copy
                </button>
                <button
                  type="button"
                  data-download-vault-index={index}
                  class="rounded border border-[#27272a] bg-[#101014] px-2.5 py-1.5 text-[#a1a1aa] hover:border-[#e5e5e5] hover:text-[#ffffff] transition-colors cursor-pointer"
                  title={`Download ${primaryFile.filename}`}
                >
                  &darr;
                </button>
              </div>
            </div>
          </article>
        );
      })}
      </div>
    </div>

    <!-- Empty Filter State -->
    <div id="vault-empty-state" class="hidden py-14 text-center font-mono text-xs text-[#71717a]">
      Tidak ada komponen yang cocok dengan pencarian tersebut.
    </div>
  </div>

  <!-- ========================================================
       CHANHDAI-STYLE FULL SOURCE CODE INSPECTOR MODAL
       ======================================================== -->
  <div
    id="vault-code-modal"
    class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="vault-modal-title"
  >
    <div class="relative w-full max-w-5xl max-h-[90vh] flex flex-col rounded-xl border-2 border-[#3f3f46] bg-[#09090c] shadow-[0_25px_70px_rgba(0,0,0,0.95)] overflow-hidden">
      <!-- Modal Top Header -->
      <div class="flex items-center justify-between gap-3 border-b border-[#27272a] bg-[#121217] px-4 sm:px-6 py-3.5">
        <div class="min-w-0">
          <div class="flex items-center gap-2 font-mono text-[10px] text-[#a1a1aa]">
            <span id="vault-modal-id" class="px-1.5 py-0.5 rounded bg-[#1c1c24] border border-[#3f3f46] text-[#e5e5e5]">CMP-01</span>
            <span id="vault-modal-path" class="truncate text-[#71717a]">src/components/...</span>
          </div>
          <h3 id="vault-modal-title" class="text-base sm:text-lg font-bold text-[#ffffff] truncate mt-0.5">
            Component Name
          </h3>
        </div>

        <button
          id="vault-modal-close"
          type="button"
          class="shrink-0 rounded-md border border-[#27272a] bg-[#18181f] px-3 py-1.5 font-mono text-xs text-[#a1a1aa] hover:border-[#e5e5e5] hover:text-[#ffffff] transition-colors cursor-pointer"
        >
          [ ESC // CLOSE ]
        </button>
      </div>

      <!-- CLI / Setup Hint + Multi-File Tabs + Copy/Download Toolbar -->
      <div class="border-b border-[#27272a] bg-[#0d0d11] px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
        <div id="vault-modal-file-tabs" class="flex flex-wrap items-center gap-1.5"></div>

        <div class="flex items-center gap-2">
          <button
            id="vault-modal-copy-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded border border-[#e5e5e5] bg-[#e5e5e5] px-3 py-1 text-xs font-bold text-[#0a0a0a] hover:bg-[#d4d4d8] transition-colors cursor-pointer"
          >
            Copy Source Code
          </button>
          <button
            id="vault-modal-download-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded border border-[#3f3f46] bg-[#16161d] px-3 py-1 text-xs text-[#e5e5e5] hover:border-[#e5e5e5] transition-colors cursor-pointer"
          >
            Download File
          </button>
        </div>
      </div>

      <!-- Dependency / Install Bar -->
      <div class="border-b border-[#1f1f26] bg-[#0a0a0e] px-4 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[#8a8a93]">
        <span id="vault-modal-install" class="truncate">$ npm install ...</span>
        <span id="vault-modal-stats" class="tabular-nums text-[#71717a]">0 lines</span>
      </div>

      <!-- Scrollable Raw Source Code Viewer -->
      <div class="flex-1 overflow-auto p-4 sm:p-6 bg-[#060608] font-mono text-xs leading-relaxed text-[#d4d4d8]">
        <pre class="m-0"><code id="vault-modal-code" class="whitespace-pre"></code></pre>
      </div>
    </div>
  </div>

  <!-- Embedded Build-Time Raw Component Payload (escaped safely against </script>) -->
  <script type="application/json" id="vaskrona-vault-json" set:html={safeVaultJson}></script>
</section>

<script>
  interface VaultFileClient {
    filename: string;
    path: string;
    language: string;
    code: string;
    lines: number;
    sizeKb: string;
  }

  interface VaultItemClient {
    id: string;
    slug: string;
    name: string;
    category: string;
    categoryLabel: string;
    description: string;
    deps: string[];
    installCmd: string;
    files: VaultFileClient[];
  }

  const payloadEl = document.getElementById('vaskrona-vault-json');
  const vaultData: VaultItemClient[] = payloadEl?.textContent ? JSON.parse(payloadEl.textContent) : [];

  // 1. Draw Live Mini Pixel Vaskrona Specimen on CMP-01 Card
  const miniCanvas = document.querySelector('.vault-mini-pixel-canvas') as HTMLCanvasElement | null;
  if (miniCanvas) {
    const mCtx = miniCanvas.getContext('2d');
    if (mCtx) {
      mCtx.imageSmoothingEnabled = false;
      let frame = 0;
      const drawMiniSpecimen = () => {
        mCtx.clearRect(0, 0, 76, 44);
        const bob = Math.sin(frame * 0.08) > 0 ? 0 : 1;
        const blink = frame % 90 > 84;

        // Mini Floating Monitor on Left
        mCtx.fillStyle = '#525252';
        mCtx.fillRect(6, 10, 24, 17);
        mCtx.fillStyle = '#0a0a0d';
        mCtx.fillRect(7, 11, 22, 15);
        mCtx.fillStyle = '#e5e5e5';
        mCtx.fillRect(9, 14, 12, 2);
        mCtx.fillStyle = '#737373';
        mCtx.fillRect(9, 18, 16, 2);
        mCtx.fillStyle = '#ffffff';
        mCtx.fillRect(9, 22, 6 + (Math.floor(frame * 0.3) % 10), 2);

        // Mini Chibi Vaskrona Character on Right
        const cx = 48;
        const cy = 12 + bob;
        // Halo
        mCtx.fillStyle = '#e5e5e5';
        mCtx.fillRect(cx - 5, cy - 5 - bob, 10, 1);
        mCtx.fillRect(cx - 6, cy - 4 - bob, 1, 1);
        mCtx.fillRect(cx + 5, cy - 4 - bob, 1, 1);
        // Hair & Head
        mCtx.fillStyle = '#18181f';
        mCtx.fillRect(cx - 7, cy - 1, 14, 11);
        mCtx.fillStyle = '#e5e5e5';
        mCtx.fillRect(cx - 5, cy + 2, 10, 8);
        // Eyes
        mCtx.fillStyle = '#09090c';
        if (blink) {
          mCtx.fillRect(cx - 4, cy + 6, 3, 1);
          mCtx.fillRect(cx + 1, cy + 6, 3, 1);
        } else {
          mCtx.fillRect(cx - 4, cy + 5, 2, 3);
          mCtx.fillRect(cx + 2, cy + 5, 2, 3);
          mCtx.fillStyle = '#ffffff';
          mCtx.fillRect(cx - 4, cy + 5, 1, 1);
          mCtx.fillRect(cx + 2, cy + 5, 1, 1);
        }
        // Coat / Body
        mCtx.fillStyle = '#1f1f28';
        mCtx.fillRect(cx - 6, cy + 10, 12, 11);
        mCtx.fillStyle = '#a1a1aa';
        mCtx.fillRect(cx - 1, cy + 11, 2, 9);
        // Boots
        mCtx.fillStyle = '#d4d4d8';
        mCtx.fillRect(cx - 5, 34, 4, 4);
        mCtx.fillRect(cx + 1, 34, 4, 4);

        frame += 1;
        requestAnimationFrame(drawMiniSpecimen);
      };
      requestAnimationFrame(drawMiniSpecimen);
    }
  }

  // 2. Category Filter & Instant Search
  const filterBtns = document.querySelectorAll('[data-vault-filter]');
  const searchInput = document.getElementById('vault-search-input') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.vault-card');
  const emptyStateEl = document.getElementById('vault-empty-state');

  let activeCategory = 'all';

  function applyVaultFilter() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const el = card as HTMLElement;
      const cat = el.getAttribute('data-vault-category') || '';
      const hay = el.getAttribute('data-vault-search') || '';
      const matchCat = activeCategory === 'all' || cat === activeCategory;
      const matchQuery = !query || hay.includes(query);

      if (matchCat && matchQuery) {
        el.classList.remove('hidden');
        visibleCount += 1;
      } else {
        el.classList.add('hidden');
      }
    });

    if (emptyStateEl) {
      emptyStateEl.classList.toggle('hidden', visibleCount > 0);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-vault-filter') || 'all';
      filterBtns.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('border-[#e5e5e5]', isCurrent);
        b.classList.toggle('bg-[#e5e5e5]', isCurrent);
        b.classList.toggle('text-[#0a0a0a]', isCurrent);
        b.classList.toggle('font-bold', isCurrent);
        b.classList.toggle('border-[#262626]', !isCurrent);
        b.classList.toggle('bg-[#0d0d10]', !isCurrent);
        b.classList.toggle('text-[#a1a1aa]', !isCurrent);
      });
      applyVaultFilter();
    });
  });

  searchInput?.addEventListener('input', applyVaultFilter);

  // 3. Clipboard & File Download Helpers
  function triggerFileDownload(filename: string, content: string) {
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  async function copyTextWithFeedback(text: string, btn: HTMLElement, copiedLabel = 'Copied!') {
    const original = btn.textContent || 'Copy';
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = copiedLabel;
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    } catch {
      btn.textContent = 'Failed';
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    }
  }

  // Quick Card Copy & Download Buttons
  document.querySelectorAll('[data-copy-vault-index]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-copy-vault-index'));
      const item = vaultData[idx];
      if (!item) return;
      const combined =
        item.files.length === 1
          ? item.files[0].code
          : item.files.map((f) => `/* === FILE: ${f.path} === */\n${f.code}`).join('\n\n');
      void copyTextWithFeedback(combined, btn as HTMLElement, '✓ Copied');
    });
  });

  document.querySelectorAll('[data-download-vault-index]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-download-vault-index'));
      const item = vaultData[idx];
      if (!item) return;
      item.files.forEach((f) => triggerFileDownload(f.filename, f.code));
    });
  });

  document.getElementById('vault-download-all-btn')?.addEventListener('click', () => {
    const bundle = {
      source: 'Hilmi Zaki Ramadhan — Secret Cavern Component Registry',
      exportedAt: new Date().toISOString(),
      totalComponents: vaultData.length,
      components: vaultData,
    };
    triggerFileDownload('vaskrona-portfolio-components-bundle.json', JSON.stringify(bundle, null, 2));
  });

  // 4. Full Source Code Inspector Modal
  const modalEl = document.getElementById('vault-code-modal');
  const modalIdEl = document.getElementById('vault-modal-id');
  const modalPathEl = document.getElementById('vault-modal-path');
  const modalTitleEl = document.getElementById('vault-modal-title');
  const modalTabsEl = document.getElementById('vault-modal-file-tabs');
  const modalInstallEl = document.getElementById('vault-modal-install');
  const modalStatsEl = document.getElementById('vault-modal-stats');
  const modalCodeEl = document.getElementById('vault-modal-code');
  const modalCopyBtn = document.getElementById('vault-modal-copy-btn');
  const modalDownloadBtn = document.getElementById('vault-modal-download-btn');
  const modalCloseBtn = document.getElementById('vault-modal-close');

  let currentModalItem: VaultItemClient | null = null;
  let currentFileIndex = 0;

  function renderModalFile() {
    if (!currentModalItem) return;
    const file = currentModalItem.files[currentFileIndex] || currentModalItem.files[0];
    if (!file) return;

    if (modalPathEl) modalPathEl.textContent = file.path;
    if (modalStatsEl) modalStatsEl.textContent = `${file.lines} lines • ${file.sizeKb}`;
    if (modalCodeEl) {
      const numbered = file.code
        .split('\n')
        .map((line, i) => `${String(i + 1).padStart(4, ' ')} | ${line}`)
        .join('\n');
      modalCodeEl.textContent = numbered;
    }

    if (modalTabsEl) {
      modalTabsEl.innerHTML = '';
      currentModalItem.files.forEach((f, fIdx) => {
        const tabBtn = document.createElement('button');
        tabBtn.type = 'button';
        const active = fIdx === currentFileIndex;
        tabBtn.className = active
          ? 'px-2.5 py-1 rounded border border-[#e5e5e5] bg-[#1f1f27] text-[#ffffff] font-semibold cursor-pointer'
          : 'px-2.5 py-1 rounded border border-[#27272a] bg-[#101015] text-[#8a8a93] hover:text-[#ffffff] cursor-pointer';
        tabBtn.textContent = f.filename;
        tabBtn.addEventListener('click', () => {
          currentFileIndex = fIdx;
          renderModalFile();
        });
        modalTabsEl.appendChild(tabBtn);
      });
    }
  }

  function openVaultModal(itemIndex: number) {
    const item = vaultData[itemIndex];
    if (!item || !modalEl) return;
    currentModalItem = item;
    currentFileIndex = 0;

    if (modalIdEl) modalIdEl.textContent = item.id;
    if (modalTitleEl) modalTitleEl.textContent = item.name;
    if (modalInstallEl) modalInstallEl.textContent = item.installCmd;

    renderModalFile();
    modalEl.classList.remove('hidden');
    modalEl.classList.add('flex');
  }

  function closeVaultModal() {
    if (!modalEl) return;
    modalEl.classList.add('hidden');
    modalEl.classList.remove('flex');
  }

  document.querySelectorAll('[data-open-vault-index]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const idx = Number(trigger.getAttribute('data-open-vault-index'));
      openVaultModal(idx);
    });
  });

  modalCloseBtn?.addEventListener('click', closeVaultModal);
  modalEl?.addEventListener('click', (e) => {
    if (e.target === modalEl) closeVaultModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalEl && !modalEl.classList.contains('hidden')) {
      closeVaultModal();
    }
  });

  modalCopyBtn?.addEventListener('click', () => {
    if (!currentModalItem || !modalCopyBtn) return;
    const file = currentModalItem.files[currentFileIndex];
    if (file) {
      void copyTextWithFeedback(file.code, modalCopyBtn, '✓ Copied Raw Source!');
    }
  });

  modalDownloadBtn?.addEventListener('click', () => {
    if (!currentModalItem) return;
    const file = currentModalItem.files[currentFileIndex];
    if (file) {
      triggerFileDownload(file.filename, file.code);
    }
  });
</script>
