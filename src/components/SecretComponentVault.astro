interface VaultFile {
  filename: string;
  path: string;
  language: string;
  code: string;
  lines: number;
  sizeKb: string;
}

interface VaultComponentItem {
  id: string;
  slug: string;
  name: string;
  category: 'pixel' | 'interactive' | 'sections' | 'styles';
  categoryLabel: string;
  featured?: boolean;
  description: string;
  deps: string[];
  installCmd: string;
  previewType: string;
  files: VaultFile[];
}

function makeFile(filename: string, path: string, language: string, raw: string): VaultFile {
  const normalized = raw.replace(/\r\n/g, '\n');
  const lines = normalized.split('\n').length;
  const bytes = new TextEncoder().encode(normalized).length;
  return {
    filename,
    path,
    language,
    code: normalized,
    lines,
    sizeKb: `${(bytes / 1024).toFixed(1)} KB`,
  };
}

